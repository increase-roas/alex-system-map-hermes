{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "record_type": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "placement_component_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "sheet": {
                "type": "string",
                "minLength": 1
              },
              "row": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "source_id",
              "sheet",
              "row"
            ],
            "additionalProperties": false
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "column": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {},
                "comment": {
                  "type": "string"
                },
                "link": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "column",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "coverage_basis": {
            "type": "string",
            "minLength": 1
          },
          "full_source": {
            "type": "object",
            "properties": {
              "sheet": {
                "type": "string",
                "minLength": 1
              },
              "row": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "sheet",
              "row"
            ],
            "additionalProperties": false
          },
          "full_cells": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "column": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {},
                "comment": {
                  "type": "string"
                },
                "link": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "column",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "asset_key": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "record_type",
          "label",
          "component_id",
          "placement_component_id",
          "source",
          "evidence_ids",
          "cells",
          "coverage_basis"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "records"
  ],
  "additionalProperties": false
}
