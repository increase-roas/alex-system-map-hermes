{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow operation request v1",
  "type": "object",
  "required": [
    "job_id",
    "expected_revision",
    "operation_id",
    "action",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "enum": [
        "create",
        "add_task",
        "update",
        "dependencies",
        "correct",
        "checkpoint",
        "verify"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "$comment": "Action-specific payload and DAG invariants are enforced by the reference engine; no schema validator dependency is installed."
}
