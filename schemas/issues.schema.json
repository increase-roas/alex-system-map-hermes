{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "superseded"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "severity": {
            "enum": [
              "information",
              "review",
              "critical"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "subject_id",
          "summary",
          "detail",
          "status",
          "evidence_ids",
          "severity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "records"
  ],
  "additionalProperties": false
}
