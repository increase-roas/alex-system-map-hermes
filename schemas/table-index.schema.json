{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sheet": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "rows": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "sheet",
          "path",
          "rows"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "records"
  ],
  "additionalProperties": false
}
