{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "documented_current",
              "historical",
              "planned",
              "unresolved"
            ]
          },
          "evidence_level": {
            "enum": [
              "reported",
              "configured",
              "tested",
              "unverified"
            ]
          },
          "observed_condition": {
            "enum": [
              "working",
              "failing",
              "blocked",
              "unknown"
            ]
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_pointer": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "source_id",
          "target_id",
          "type",
          "label",
          "category",
          "evidence_level",
          "observed_condition",
          "observed_at",
          "evidence_ids",
          "resolution",
          "source_pointer"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "records"
  ],
  "additionalProperties": false
}
