   430	
   431	class KeyCache:
   432	    """Holds each upstream's auth header, and refuses to hammer 1Password for it.
   433	
   434	    The backoff is the important part. The 1Password service account is shared by
   435	    every agent on this Mac and has a daily read cap. On 2026-10-20 this collector
   436	    read three secrets per launch, crashed on a slow read, and launchd's KeepAlive
   437	    relaunched it: the loop exhausted the account's authenticated path for everyone
   438	    until the reads stopped. So a failed read now blocks further attempts for an
   439	    exponentially growing interval, and a caller gets an immediate refusal instead
   440	    of a new subprocess.
   441	    """
   442	
   443	    def __init__(self, names: list[str], ttl: int = KEY_TTL):
   444	        self.names = names
   445	        self.ttl = ttl
   446	        self.lock = threading.Lock()
   447	        self.cache: dict[str, tuple[str, float]] = {}
   448	        self.failures: dict[str, int] = {}
   449	        self.blocked_until: dict[str, float] = {}
   450	
   451	    def backoff_for(self, failures: int) -> float:
   452	        return min(KEY_BACKOFF_BASE * (2 ** max(failures - 1, 0)), KEY_BACKOFF_MAX)
   453	
   454	    def get(self, name: str) -> str:
   455	        now = time.monotonic()
   456	        with self.lock:
   457	            hit = self.cache.get(name)
   458	            if hit and now - hit[1] < self.ttl:
   459	                return hit[0]
   460	            wait = self.blocked_until.get(name, 0.0) - now
   461	            if wait > 0:
   462	                raise Blocked(f'{name} key unavailable; not retrying for {wait:.0f}s')
   463	        try:
   464	            value = auth_for(name)
   465	        except Blocked:
   466	            with self.lock:
   467	                self.failures[name] = self.failures.get(name, 0) + 1
   468	                delay = self.backoff_for(self.failures[name])
   469	                self.blocked_until[name] = time.monotonic() + delay
   470	                count = self.failures[name]
   471	            print(f'  {name} key read failed ({count} in a row); holding off {delay:.0f}s '
   472	                  f'so 1Password is not hammered', file=sys.stderr)
   473	            sys.stderr.flush()
   474	            raise
   475	        with self.lock:
   476	            self.cache[name] = (value, time.monotonic())
   477	            self.failures.pop(name, None)
   478	            self.blocked_until.pop(name, None)
   479	        return value
   480	
   481	    def peek(self, name: str) -> str:
   482	        """Cached value only. NEVER calls 1Password, so it cannot block a request.
   483	
   484	        The request path must not wait on a credential: on 2026-10-20 a span arriving
   485	        while the keys were cold held the HTTP handler for 90 seconds and the sender
   486	        timed out. A span that cannot be forwarded right now is counted and dropped,
   487	        which is visible in /stats, instead of stalling whoever sent it. The
   488	        background warmer is the only thing that calls out to 1Password.
   489	        """
   490	        with self.lock:
   491	            hit = self.cache.get(name)
   492	            if hit and time.monotonic() - hit[1] < self.ttl:
   493	                return hit[0]
   494	        raise Blocked(f'{name} key not cached yet')
   495	
   496	    def drop(self, name: str) -> None:
   497	        with self.lock:
   498	            self.cache.pop(name, None)
   499	
   500	
   501	def forward(name: str, body: bytes, keys: KeyCache) -> int:
   502	    url, header = UPSTREAMS[name]
   503	    from urllib.parse import urlsplit
   504	    if urlsplit(url).hostname not in ALLOWED_HOSTS:
   505	        raise Blocked('refused: upstream host is not in ALLOWED_HOSTS')
   506	    headers = {'Content-Type': 'application/x-protobuf', header: keys.peek(name)}
   507	    if name == 'langfuse':
   508	        headers['x-langfuse-ingestion-version'] = '4'
   509	    req = urllib.request.Request(url, data=body, headers=headers, method='POST')
   510	    try:
   511	        with urllib.request.urlopen(req, timeout=IO_TIMEOUT) as resp:
   512	            resp.read(64 * 1024)
   513	            return resp.status
   514	    except urllib.error.HTTPError as err:
   515	        err.read(4096)
   516	        if err.code in (401, 403):
   517	            keys.drop(name)  # a rotated key should not stay rejected until the TTL
   518	        return err.code
   519	    except urllib.error.URLError:
   520	        return 0  # network failure; never surface the reason, it can carry a URL with auth
   521	
