   523	# --------------------------------------------------------------------------- server
   524	
   525	class Stats:
   526	    def __init__(self):
   527	        self.lock = threading.Lock()
   528	        self.kept = collections.Counter()
   529	        self.dropped = collections.Counter()
   530	        self.upstream = collections.Counter()
   531	        self.started = time.time()
   532	
   533	    def add(self, decision: Decision, statuses: dict[str, int]):
   534	        with self.lock:
   535	            self.kept.update(decision.kept)
   536	            self.dropped.update(decision.dropped)
   537	            for name, status in statuses.items():
   538	                self.upstream[f'{name}:{status}'] += 1
   539	
   540	    def snapshot(self) -> dict:
   541	        with self.lock:
   542	            hours = max((time.time() - self.started) / 3600, 1 / 3600)
   543	            return {
   544	                'uptime_hours': round(hours, 3),
   545	                'kept_spans': dict(self.kept),
   546	                'kept_spans_per_hour': {k: round(v / hours) for k, v in self.kept.items()},
   547	                'dropped_spans': dict(self.dropped),
   548	                'upstream_responses': dict(self.upstream),
   549	            }
   550	
   551	
   552	def is_loopback(host: str) -> bool:
   553	    try:
   554	        return ipaddress.ip_address(host).is_loopback
   555	    except ValueError:
   556	        return False
   557	
   558	
   559	class Collector(ThreadingHTTPServer):
   560	    daemon_threads = True
   561	    allow_reuse_address = True
   562	
   563	    def __init__(self, address, *, upstreams: list[str], guard: RateGuard,
   564	                 keys: KeyCache, dry_run: bool, log_path: Path | None):
   565	        super().__init__(address, Handler)
   566	        self.upstreams = upstreams
   567	        self.guard = guard
   568	        self.keys = keys
   569	        self.dry_run = dry_run
   570	        self.log_path = log_path
   571	        self.stats = Stats()
   572	
   573	    def log_row(self, row: dict) -> None:
   574	        if not self.log_path:
   575	            return
   576	        try:
   577	            with open(self.log_path, 'a') as handle:
   578	                handle.write(json.dumps(row) + '\n')
   579	        except OSError:
   580	            pass  # best effort: never fail a request because the log is unwritable
   581	
   582	
   583	class Handler(BaseHTTPRequestHandler):
   584	    protocol_version = 'HTTP/1.1'
   585	
   586	    def log_message(self, *args):
   587	        pass  # the request line could carry a query string; never log it
   588	
   589	    def _reply(self, status: int, body: bytes = b'') -> None:
   590	        self.send_response(status)
   591	        self.send_header('Content-Length', str(len(body)))
   592	        self.end_headers()
   593	        if body:
   594	            self.wfile.write(body)
   595	
   596	    def do_GET(self):
   597	        if self.path == '/stats':
   598	            body = json.dumps(self.server.stats.snapshot(), indent=2).encode()
   599	            self.send_response(200)
   600	            self.send_header('Content-Type', 'application/json')
   601	            self.send_header('Content-Length', str(len(body)))
   602	            self.end_headers()
   603	            self.wfile.write(body)
   604	            return
   605	        self._reply(404)
   606	
   607	    def do_POST(self):
   608	        if not is_loopback(self.client_address[0]):
   609	            self._reply(403)
   610	            return
   611	        if self.path != '/v1/traces':
   612	            self._reply(404)
   613	            return
   614	        try:
   615	            length = int(self.headers.get('Content-Length') or 0)
   616	        except ValueError:
   617	            self._reply(400)
   618	            return
   619	        if length <= 0 or length > MAX_BODY:
   620	            self._reply(413 if length > MAX_BODY else 400)
   621	            return
   622	        body = self.rfile.read(length)
   623	        try:
   624	            decision = filter_payload(body, self.server.guard)
   625	        except ValueError:
   626	            self._reply(400)
   627	            return
   628	
   629	        statuses: dict[str, int] = {}
   630	        if decision.body and not self.server.dry_run:
   631	            for name in self.server.upstreams:
   632	                try:
   633	                    statuses[name] = forward(name, decision.body, self.server.keys)
   634	                except Blocked:
   635	                    statuses[name] = -1
   636	        self.server.stats.add(decision, statuses)
   637	        self.server.log_row({
   638	            'ts': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
   639	            'bytes_in': length, 'kept': decision.kept, 'dropped': decision.dropped,
   640	            'upstream': statuses, 'dry_run': self.server.dry_run,
   641	        })
   642	        self._reply(200 if (not statuses or any(s == 200 for s in statuses.values())) else 502)
   643	
