   645	# --------------------------------------------------------------------------- self test
   646	
   647	def self_test() -> int:
   648	    """No network, no listener. Proves the filter does what the docstring claims."""
   649	    import struct
   650	
   651	    def kvbody(key: str, val: str) -> bytes:
   652	        return delimited(1, key.encode()) + delimited(2, delimited(1, val.encode()))
   653	
   654	    def span(name: str) -> bytes:
   655	        now = time.time_ns()
   656	        return b''.join([
   657	            delimited(1, b'\x11' * 16), delimited(2, b'\x22' * 8), delimited(5, name.encode()),
   658	            varint((6 << 3) | 0) + varint(1),
   659	            varint((7 << 3) | 1) + struct.pack('<Q', now),
   660	            varint((8 << 3) | 1) + struct.pack('<Q', now + 1000),
   661	        ])
   662	
   663	    def resource_spans(service: str | None, n: int) -> bytes:
   664	        resource = delimited(1, kvbody('service.name', service)) if service is not None else b''
   665	        scope = delimited(2, b''.join(delimited(2, span(f's{i}')) for i in range(n)))
   666	        return delimited(1, delimited(1, resource) + scope)
   667	
   668	    checks: list[tuple[str, bool, str]] = []
   669	
   670	    def check(name: str, ok: bool, detail: str = ''):
   671	        checks.append((name, bool(ok), detail))
   672	
   673	    guard = RateGuard(DEFAULT_RATE_PER_MIN, {})
   674	    d = filter_payload(resource_spans('claude-code', 3), guard)
   675	    check('named service kept', d.kept == {'claude-code': 3} and len(d.body) > 0)
   676	
   677	    d = filter_payload(resource_spans(None, 2), RateGuard(600, {}))
   678	    check('resource with no attributes dropped', d.dropped == {'(unnamed)': 2} and d.body == b'')
   679	
   680	    d = filter_payload(resource_spans('', 2), RateGuard(600, {}))
   681	    check('empty service.name dropped', d.dropped == {'(unnamed)': 2} and d.body == b'')
   682	
   683	    d = filter_payload(resource_spans('codex-worker', 5), RateGuard(600, {}))
   684	    check('blocked service refused', d.dropped == {'blocked:codex-worker': 5} and d.body == b'')
   685	
   686	    d = filter_payload(resource_spans('typo-agent', 1), RateGuard(600, {}))
   687	    check('unknown name counted, not silently kept', d.dropped == {'unknown:typo-agent': 1})
   688	
   689	    # The flood case: labelled, known, but far over budget.
   690	    tiny = RateGuard(10, {})
   691	    first = filter_payload(resource_spans('claude-code', 10), tiny)
   692	    second = filter_payload(resource_spans('claude-code', 10), tiny)
   693	    check('rate guard passes the first burst', first.kept == {'claude-code': 10})
   694	    check('rate guard throttles the flood', second.dropped == {'throttled:claude-code': 10})
   695	
   696	    # One over-budget service must not starve another.
   697	    shared = RateGuard(10, {})
   698	    filter_payload(resource_spans('claude-code', 10), shared)
   699	    other = filter_payload(resource_spans('codex', 5), shared)
   700	    check('one sender cannot starve another', other.kept == {'codex': 5})
   701	
   702	    mixed = filter_payload(
   703	        resource_spans('claude-code', 1) + resource_spans(None, 4) + resource_spans('codex', 2),
   704	        RateGuard(600, {}))
   705	    check('mixed batch keeps the named and drops the rest',
   706	          mixed.kept == {'claude-code': 1, 'codex': 2} and mixed.dropped == {'(unnamed)': 4})
   707	    check('re-emitted body is parseable OTLP',
   708	          filter_payload(mixed.body, RateGuard(600, {})).kept == {'claude-code': 1, 'codex': 2})
   709	
   710	    check('loopback check rejects a public address', not is_loopback('8.8.8.8'))
   711	    check('loopback check accepts 127.0.0.1', is_loopback('127.0.0.1'))
   712	
   713	    # The amplifier fix. These exist because on 2026-10-20 this collector exhausted the
   714	    # shared 1Password service account by reading keys inside a KeepAlive restart loop.
   715	    calls = {'n': 0}
   716	    real_auth = globals()['auth_for']
   717	
   718	    def counting_auth(name):
   719	        calls['n'] += 1
   720	        raise Blocked('simulated 1Password failure')
   721	
   722	    globals()['auth_for'] = counting_auth
   723	    try:
   724	        cache = KeyCache(['signoz'])
   725	        refusals = []
   726	        for _ in range(5):
   727	            try:
   728	                cache.get('signoz')
   729	            except Blocked as err:
   730	                refusals.append(str(err))
   731	        check('five requests cause ONE call to 1Password, not five',
   732	              calls['n'] == 1, f'calls made: {calls["n"]}')
   733	        check('later requests are refused without calling out',
   734	              len(refusals) == 5 and any('not retrying' in r for r in refusals[1:]),
   735	              f'refusals: {refusals[1:2]}')
