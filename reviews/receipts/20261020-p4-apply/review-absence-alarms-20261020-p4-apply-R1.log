   255	def filter_payload(body: bytes, guard: RateGuard, known=KNOWN_SERVICES,
   256	                   blocked=BLOCKED_SERVICES) -> Decision:
   257	    """Keep only named, allowed, in-budget ResourceSpans. Re-emit valid OTLP."""
   258	    kept_counts: dict[str, int] = collections.Counter()
   259	    dropped: dict[str, int] = collections.Counter()
   260	    out = bytearray()
   261	    for field, wire, payload, _s, _e in iter_fields(body):
   262	        if field != 1 or wire != 2:
   263	            continue  # ExportTraceServiceRequest.resource_spans only
   264	        resource = b''
   265	        for rf, rw, rp, _rs, _re in iter_fields(payload):
   266	            if rf == 1 and rw == 2:
   267	                resource = rp
   268	                break
   269	        service = service_name_of(resource)
   270	        spans = count_spans(payload)
   271	        if not service:
   272	            dropped['(unnamed)'] += spans
   273	            continue
   274	        if service in blocked:
   275	            dropped[f'blocked:{service}'] += spans
   276	            continue
   277	        if known and service not in known:
   278	            dropped[f'unknown:{service}'] += spans
   279	            continue
   280	        if not guard.allow(service, spans):
   281	            dropped[f'throttled:{service}'] += spans
   282	            continue
   283	        kept_counts[service] += spans
   284	        out += delimited(1, payload)
   285	    return Decision(bytes(out), dict(kept_counts), dict(dropped))
   286	
   287	
   288	# --------------------------------------------------------------------------- upstreams
   289	
   290	def _run(cmd: list[str], env: dict | None = None) -> str:
   291	    """Run a command, returning stdout. stderr is dropped: it could hold a key.
   292	
   293	    Every subprocess failure, a timeout included, becomes a Blocked carrying no
   294	    payload. Before this, a TimeoutExpired escaped as an unhandled traceback: it
   295	    killed the process and printed the command line into the job log, and KeepAlive
   296	    then relaunched it while still reporting "state = running".
   297	    """
   298	    try:
   299	        proc = subprocess.run(cmd, capture_output=True, text=True, env=env,
   300	                              timeout=HELPER_TIMEOUT)
   301	    except subprocess.TimeoutExpired:
   302	        raise Blocked(f'{Path(cmd[0]).name} did not answer within {HELPER_TIMEOUT}s') from None
   303	    except subprocess.SubprocessError:
   304	        raise Blocked(f'{Path(cmd[0]).name} could not be run') from None
   305	    if proc.returncode:
   306	        raise Blocked(f'{Path(cmd[0]).name} failed (exit {proc.returncode}); output withheld')
   307	    return proc.stdout.strip()
   308	
   309	
   310	# The proven credential path, reused rather than reimplemented.
   311	#
   312	# The hang I spent hours on is documented in op_items.robot_env: "Under the real HOME,
   313	# op 2.39.0 on Alex's MacBook stalls for minutes before any network step; with a private
   314	# HOME it answers in about a second". It also records that OP_BIOMETRIC_UNLOCK_ENABLED
   315	# and OP_CACHE alone do NOT stop it. I had set exactly those two and passed the real
   316	# HOME, which is why every launchd read timed out and why macOS kept asking Alex to let
   317	# "op" reach other apps: with the real HOME, op goes near the 1Password app's data.
   318	#
   319	# robot_env gives op a private HOME, OP_CONFIG_DIR and TMPDIR under
   320	# ~/.agents/runtime/op-robot, drops XDG_RUNTIME_DIR, and lets one `op daemon` serve every
   321	# robot call. Nothing here is hand-rolled any more.
   322	#
   323	# On top of that, finished headers are cached in the login Keychain, the same pattern
   324	# langfuse_otel_headers.py added on 2026-10-15 after 7,200 op calls a day starved every
   325	# other op tool. `security` works fine under launchd and never prompts, so the common
   326	# path touches 1Password not at all.
   327	CONNECTORS = Path.home() / '.agents/tools/connectors'
   328	LANGFUSE_HELPER = CONNECTORS / 'langfuse_otel_headers.py'
   329	SECURITY = '/usr/bin/security'
   330	CACHE_ACCOUNT = 'connectors-sync'
   331	CACHE_TTL_SECONDS = 12 * 3600
   332	SIGNOZ_CACHE_SERVICE = 'signoz-ingestion-header-cache'
   333	ROBOT_TOKEN_SERVICE = 'op-service-account-connectors-sync'
   334	# A single read gets a SHORT ceiling on purpose. A long one is worse than useless when
   335	# the failure mode is a modal dialog waiting on a human: it holds the prompt on screen.
   336	# A healthy robot call answers in about a second.
   337	OP_READ_TIMEOUT = 10
   338	
   339	
   340	def _load_op_items():
   341	    """Import the shared op_items module from ~/.agents. Read-only use of their code."""
   342	    import importlib.util
   343	    spec = importlib.util.spec_from_file_location('op_items', CONNECTORS / 'op_items.py')
   344	    if spec is None or spec.loader is None:
   345	        raise Blocked('op_items.py not found; cannot read credentials the proven way')
   346	    module = importlib.util.module_from_spec(spec)
   347	    spec.loader.exec_module(module)
   348	    return module
   349	
   350	
   351	def _keychain_get(service: str) -> dict | None:
   352	    proc = subprocess.run([SECURITY, 'find-generic-password', '-a', CACHE_ACCOUNT,
   353	                           '-s', service, '-w'], capture_output=True, text=True,
   354	                          timeout=OP_READ_TIMEOUT)
   355	    if proc.returncode:
   356	        return None
   357	    try:
   358	        held = json.loads(proc.stdout.strip())
   359	    except ValueError:
   360	        return None
   361	    if not isinstance(held, dict) or time.time() - float(held.get('ts', 0)) >= CACHE_TTL_SECONDS:
   362	        return None
   363	    headers = held.get('headers')
   364	    return headers if isinstance(headers, dict) and headers else None
   365	
   366	
   367	def _keychain_put(service: str, headers: dict) -> None:
   368	    # security(1) -i reads its command from stdin, so no credential rides in argv.
   369	    import shlex
   370	    command = ['add-generic-password', '-U', '-a', CACHE_ACCOUNT, '-s', service, '-w',
   371	               json.dumps({'ts': time.time(), 'headers': headers})]
   372	    subprocess.run([SECURITY, '-i'], input=shlex.join(command) + '\n',
   373	                   capture_output=True, text=True, timeout=OP_READ_TIMEOUT)
   374	
   375	
   376	def _robot_token() -> str:
   377	    proc = subprocess.run([SECURITY, 'find-generic-password', '-a', CACHE_ACCOUNT,
   378	                           '-s', ROBOT_TOKEN_SERVICE, '-w'], capture_output=True, text=True,
   379	                          timeout=OP_READ_TIMEOUT)
   380	    if proc.returncode or not proc.stdout.strip():
   381	        raise Blocked('the robot service-account token is not readable')
   382	    return proc.stdout.strip()
   383	
   384	
   385	def signoz_headers() -> dict:
   386	    """SigNoz ingestion header, Keychain-cached, read through robot_env on a miss."""
   387	    cached = _keychain_get(SIGNOZ_CACHE_SERVICE)
   388	    if cached:
   389	        return cached
   390	    op_items = _load_op_items()
   391	    token = _robot_token()
   392	    with op_items.robot_env(token) as env:
   393	        proc = subprocess.run(['op', 'read', SIGNOZ_OP_REF], capture_output=True, text=True,
   394	                              env=env, stdin=subprocess.DEVNULL, timeout=OP_READ_TIMEOUT)
   395	    if proc.returncode or not proc.stdout.strip():
   396	        raise Blocked('the SigNoz key could not be read from 1Password')
   397	    key = proc.stdout.strip()
   398	    if '\n' in key or '\r' in key:
   399	        raise Blocked('the SigNoz key does not have the expected shape')
   400	    headers = {SIGNOZ_HEADER: key}
   401	    _keychain_put(SIGNOZ_CACHE_SERVICE, headers)
   402	    return headers
   403	
   404	
   405	def langfuse_headers() -> dict:
   406	    """Langfuse headers from the EXISTING helper, which already owns its own 12h cache."""
   407	    if not LANGFUSE_HELPER.exists():
   408	        raise Blocked('the Langfuse header helper is missing')
   409	    proc = subprocess.run([sys.executable, '-B', str(LANGFUSE_HELPER)], capture_output=True,
   410	                          text=True, stdin=subprocess.DEVNULL, timeout=OP_READ_TIMEOUT)
   411	    if proc.returncode:
   412	        raise Blocked('the Langfuse header helper would not answer')
   413	    try:
   414	        headers = json.loads(proc.stdout.strip())
   415	    except ValueError:
   416	        raise Blocked('the Langfuse header helper returned nothing usable') from None
   417	    if not isinstance(headers, dict) or 'Authorization' not in headers:
   418	        raise Blocked('the Langfuse header helper returned no Authorization')
   419	    return headers
   420	
   421	
   422	def auth_for(name: str) -> str:
   423	    """Header VALUE for one upstream. Never print or log the return value."""
   424	    if name == 'signoz':
   425	        return signoz_headers()[SIGNOZ_HEADER]
   426	    if name == 'langfuse':
   427	        return langfuse_headers()['Authorization']
   428	    raise Blocked(f'no credential route for upstream {name}')
