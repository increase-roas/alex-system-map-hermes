   244	# --------------------------------------------------------------------------- filtering
   245	
   246	class Decision:
   247	    __slots__ = ('body', 'kept', 'dropped')
   248	
   249	    def __init__(self, body: bytes, kept: dict, dropped: dict):
   250	        self.body = body
   251	        self.kept = kept
   252	        self.dropped = dropped
   253	
   254	
   255	def filter_payload(body: bytes, guard: RateGuard, known=KNOWN_SERVICES,
   256	                   blocked=BLOCKED_SERVICES) -> Decision:
   257	    """Keep only named, allowed, in-budget ResourceSpans. Re-emit valid OTLP."""
   258	    kept_counts: dict[str, int] = collections.Counter()
   259	    dropped: dict[str, int] = collections.Counter()
   260	    out = bytearray()
   261	    for field, wire, payload, _s, _e in iter_fields(body):
   262	        if field != 1 or wire != 2:
   263	            continue  # ExportTraceServiceRequest.resource_spans only
   264	        resource = b''
   265	        for rf, rw, rp, _rs, _re in iter_fields(payload):
   266	            if rf == 1 and rw == 2:
   267	                resource = rp
   268	                break
   269	        service = service_name_of(resource)
   270	        spans = count_spans(payload)
   271	        if not service:
   272	            dropped['(unnamed)'] += spans
   273	            continue
   274	        if service in blocked:
   275	            dropped[f'blocked:{service}'] += spans
   276	            continue
   277	        if known and service not in known:
   278	            dropped[f'unknown:{service}'] += spans
   279	            continue
   280	        if not guard.allow(service, spans):
   281	            dropped[f'throttled:{service}'] += spans
   282	            continue
   283	        kept_counts[service] += spans
   284	        out += delimited(1, payload)
   285	    return Decision(bytes(out), dict(kept_counts), dict(dropped))
