   778	def main(argv: list[str] | None = None) -> int:
   779	    parser = argparse.ArgumentParser(description=__doc__,
   780	                                     formatter_class=argparse.RawDescriptionHelpFormatter)
   781	    parser.add_argument('--port', type=int, default=4320)
   782	    parser.add_argument('--upstream', action='append', choices=sorted(UPSTREAMS),
   783	                        help='repeatable; omit with --dry-run to forward nowhere')
   784	    parser.add_argument('--dry-run', action='store_true',
   785	                        help='accept, filter and count, but forward nothing')
   786	    parser.add_argument('--rate-per-min', type=int, default=DEFAULT_RATE_PER_MIN)
   787	    parser.add_argument('--log', default=None, help='JSONL path for per-request counts')
   788	    parser.add_argument('--self-test', action='store_true')
   789	    args = parser.parse_args(argv)
   790	
   791	    if args.self_test:
   792	        return self_test()
   793	
   794	    upstreams = args.upstream or []
   795	    if not upstreams and not args.dry_run:
   796	        print('Refusing to start: pass --upstream, or --dry-run to forward nothing.',
   797	              file=sys.stderr)
   798	        return 2
   799	
   800	    guard = RateGuard(args.rate_per_min, RATE_OVERRIDES)
   801	    keys = KeyCache(upstreams)
   802	
   803	    # Under launchd a stop arrives as SIGTERM, not KeyboardInterrupt. shutdown() cannot
   804	    # be called from the serving thread, so the handler only sets this flag and the main
   805	    # thread closes the listener and lets in-flight requests finish. Declared here
   806	    # because the key-warming thread waits on it too.
   807	    stop = threading.Event()
   808	
   809	    server = Collector(('127.0.0.1', args.port), upstreams=upstreams, guard=guard, keys=keys,
   810	                       dry_run=args.dry_run, log_path=Path(args.log) if args.log else None)
   811	    print(f'  listening on 127.0.0.1:{server.server_address[1]}/v1/traces')
   812	    print(f'  upstreams: {", ".join(upstreams) or "(none, dry run)"}')
   813	    print(f'  rate guard: {args.rate_per_min} spans/min per service')
   814	    print(f'  blocked: {", ".join(BLOCKED_SERVICES)}')
   815	    print(f'  counts: GET http://127.0.0.1:{server.server_address[1]}/stats')
   816	    sys.stdout.flush()
   817	
   818	    # Keys are warmed in the BACKGROUND, after the listener is already bound. Reading
   819	    # them first was a design bug: on 2026-10-20 a slow `op read` under launchd held the
   820	    # startup path for minutes, so the port never opened and the service looked dead
   821	    # while the process was perfectly healthy. Binding first means /stats answers at
   822	    # once, a span that cannot be forwarded is counted rather than lost, and the thing
   823	    # is diagnosable from outside. KeyCache's backoff keeps the retries cheap.
   824	    def warm_keys():
   825	        for name in upstreams:
   826	            while not stop.is_set():
   827	                try:
   828	                    keys.get(name)
   829	                    print(f'  {name} key read from 1Password (value not shown)')
   830	                    sys.stdout.flush()
   831	                    break
   832	                except Blocked as err:
   833	                    print(f'  {name} key still unavailable: {err}', file=sys.stderr)
   834	                    sys.stderr.flush()
   835	                    if stop.wait(KEY_BACKOFF_BASE):
   836	                        return
   837	
   838	    if upstreams and not args.dry_run:
   839	        threading.Thread(target=warm_keys, daemon=True, name='warm-keys').start()
   840	
   841	    previous = {}
   842	    worker = threading.Thread(target=server.serve_forever, kwargs={'poll_interval': 0.5})
   843	    try:
   844	        for sig in (signal.SIGTERM, signal.SIGINT):
   845	            previous[sig] = signal.signal(sig, lambda *_: stop.set())
   846	        worker.start()
   847	        stop.wait()
   848	    finally:
   849	        if worker.is_alive():
   850	            server.shutdown()
   851	            worker.join(timeout=10)
   852	        server.server_close()
   853	        for sig, handler in previous.items():
   854	            signal.signal(sig, handler)
   855	    # The final counts go to stdout, which launchd captures in the job's log.
   856	    print(json.dumps(server.stats.snapshot(), indent=2))
   857	    sys.stdout.flush()
   858	    return 0
   859	
   860	
   861	if __name__ == '__main__':
   862	    sys.exit(main())

