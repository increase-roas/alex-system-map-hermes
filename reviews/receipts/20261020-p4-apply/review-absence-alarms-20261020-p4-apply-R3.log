FILE: reviews/receipts/20261020-p4-apply/evidence/09-collector-source.py
1: #!/usr/bin/env python3
2: """A loopback OTLP collector that names, caps and fans out agent traces.
3: 
4: WHY THIS EXISTS AND NOT A PATCH TO THE EXISTING RELAY
5: -----------------------------------------------------
6: `~/.agents/tools/connectors/codex_otel/otlp_relay.py` is a security-reviewed
7: component whose documented contract is that it forwards OTLP bytes unchanged and
8: "does not inspect or change span bodies". Dropping spans by name and rate-limiting
9: per service both require parsing the payload, which is exactly the property that
10: file was reviewed for not having. It is also under ~/.agents, which this project
11: may not edit.
12: 
13: So this is a separate collector, in this repo, where it can be read, tested and
14: reverted. The existing relay keeps its contract and, since the ChatGPT app's Codex
15: tracing was switched off on 2026-10-19, currently has no clients at all.
16: 
17: WHAT IT DOES
18: ------------
19: 1. Accepts OTLP/HTTP protobuf on POST /v1/traces, loopback only.
20: 2. Drops any ResourceSpans whose resource has no non-empty `service.name`.
21:    SigNoz does NOT do this for you: a span with no resource attributes at all was
22:    accepted with HTTP 200 on 2026-10-20 (trace 271bb7f1cea12b2b365fc23aee6a034c).
23: 3. Refuses service names on a block list outright.
24: 4. Rate-guards EVERY service with its own token bucket, so one sender cannot flood
25:    the account. This is the lesson from 2026-10-19: the Langfuse flood came from
26:    spans that WERE labelled (Langfuse environment "codex-worker", ~0.9M-1.4M
27:    observations an hour), so a name-based drop alone would not have stopped it.
28:    Naming and capping are two different jobs and both are needed.
29: 5. Fans out what survives to one or more upstreams, each with its own auth header
30:    read from 1Password at run time. Never logs a key, a span body or a header.
31: 6. Counts kept, unnamed, blocked and throttled spans per service, so the per-service
32:    hourly rate can be reported without reading anything back from a vendor.
33: 
34: NOT DURABLE BY ITSELF. It runs in the foreground. Keeping it alive across reboots
35: needs a LaunchAgent, which this project cannot write; see the handover note in
36: docs/ for the one-line change and who has to make it.
37: 
38: Run:
39:     python3 -B tools/otel_collector.py --port 4320 --upstream signoz
40:     python3 -B tools/otel_collector.py --dry-run --port 4320    # accept, count, forward nothing
41:     python3 -B tools/otel_collector.py --self-test              # no network, no listener
42: """
43: from __future__ import annotations
44: 
45: import argparse
46: import collections
47: import ipaddress
48: import json
49: import os
50: import re
51: import signal
52: import subprocess
53: import sys
54: import threading
55: import time
56: import urllib.error
57: import urllib.request
58: from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
59: from pathlib import Path
60: 
61: # Allowlist. The only hosts this file may reach, named here as tools/** requires.
62: ALLOWED_HOSTS = ('ingest.us2.signoz.cloud', 'us.cloud.langfuse.com')
63: 
64: SIGNOZ_HEADER = 'signoz-ingestion-key'
65: # 1Password vault Connectors, item "SigNoz ingestion key", field credential.
66: SIGNOZ_OP_REF = 'op://Connectors/hfy4llw7gassge2w5xuz64kgyu/credential'
67: 
68: UPSTREAMS = {
69:     # name: (url, header name). The credential route per upstream lives in auth_for():
70:     # SigNoz through robot_env plus a Keychain cache, Langfuse through the existing
71:     # langfuse_otel_headers.py helper, which already owns its own cache.
72:     'signoz': ('https://ingest.us2.signoz.cloud/v1/traces', SIGNOZ_HEADER),
73:     'langfuse': ('https://us.cloud.langfuse.com/api/public/otel/v1/traces', 'Authorization'),
74: }
75: 
76: # Names that are allowed through at all. Anything else is counted and dropped, so a
77: # typo in an agent's config shows up as a number instead of silently becoming "other".
78: KNOWN_SERVICES = (
79:     'claude-code', 'codex', 'cursor', 'javar', 'javante', 'auditor',
80:     'task-codex', 'task-claude', 'paperclip-worker', 'paperclip-reviewer',
81:     'dynamite-chatbot', 'alex-system-map',
82: )
83: 
84: # Never forwarded. The ChatGPT app's built-in Codex sent roughly 4.7M events a week
85: # into Langfuse with no per-run session id; Alex switched it off on 2026-10-19 and the
86: # Director's instruction is that it is not to be forwarded here either unless it is
87: # sampled hard and Alex agrees.
88: BLOCKED_SERVICES = ('codex-worker',)
89: 
90: # Spans per minute per service, and the burst each may hold. Set from the measured
91: # 7-day behaviour on 2026-10-19: Claude Code ran about 110,000 units a week, which is
92: # roughly 11 spans a minute, so 600 leaves two orders of magnitude of headroom while
93: # still stopping a runaway. A service that legitimately needs more should be raised
94: # here deliberately, with the reason, rather than the cap being removed.
95: DEFAULT_RATE_PER_MIN = 600
96: RATE_OVERRIDES: dict[str, int] = {}
97: 
98: MAX_BODY = 16 * 1024 * 1024
99: IO_TIMEOUT = 30
100: # `op read` needs considerably longer than a local helper script, especially on a
101: # cold start under launchd where the service account has to authenticate before the
102: # first read. Measured 2026-10-20: at 15 seconds the job died twice with
103: # subprocess.TimeoutExpired and only survived its third launch, while KeepAlive kept
104: # reporting "state = running" the whole time. That is the exact silent-success shape
105: # this project exists to remove, so the timeout is generous and the retry is explicit.
106: HELPER_TIMEOUT = 90
107: KEY_TTL = 3600
108: # Backoff after a failed key read, doubling each time, so a credential problem costs
109: # 1Password a handful of calls rather than one every few seconds forever.
110: KEY_BACKOFF_BASE = 30
111: KEY_BACKOFF_MAX = 900
112: 
113: 
114: class Blocked(Exception):
115:     """A step could not run. The message never carries credential text."""
116: 
117: 
118: # --------------------------------------------------------------------------- protobuf
119: 
120: def read_varint(buf: bytes, i: int) -> tuple[int, int]:
121:     shift = 0
122:     value = 0
123:     while True:
124:         if i >= len(buf):
125:             raise ValueError('truncated varint')
126:         byte = buf[i]
127:         i += 1
128:         value |= (byte & 0x7F) << shift
129:         if not byte & 0x80:
130:             return value, i
131:         shift += 7
132:         if shift > 63:
133:             raise ValueError('varint too long')
134: 
135: 
136: def iter_fields(buf: bytes):
137:     """Yield (field_number, wire_type, payload_bytes_or_int, start, end) over one message."""
138:     i = 0
139:     while i < len(buf):
140:         start = i
141:         key, i = read_varint(buf, i)
142:         field, wire = key >> 3, key & 0x7
143:         if wire == 0:
144:             val, i = read_varint(buf, i)
145:             yield field, wire, val, start, i
146:         elif wire == 1:
147:             yield field, wire, buf[i:i + 8], start, i + 8
148:             i += 8
149:         elif wire == 2:
150:             length, i = read_varint(buf, i)
151:             if i + length > len(buf):
152:                 raise ValueError('truncated length-delimited field')
153:             yield field, wire, buf[i:i + length], start, i + length
154:             i += length
155:         elif wire == 5:
156:             yield field, wire, buf[i:i + 4], start, i + 4
157:             i += 4
158:         else:
159:             raise ValueError(f'unsupported wire type {wire}')
160: 
161: 
162: def varint(value: int) -> bytes:
163:     out = bytearray()
164:     while True:
165:         byte = value & 0x7F
166:         value >>= 7
167:         out.append(byte | (0x80 if value else 0))
168:         if not value:
169:             return bytes(out)
170: 
171: 
172: def delimited(field: int, payload: bytes) -> bytes:
173:     return varint((field << 3) | 2) + varint(len(payload)) + payload
174: 
175: 
176: def service_name_of(resource: bytes) -> str:
177:     """Read service.name out of a Resource message. '' when absent or empty.
178: 
179:     Resource.attributes = field 1, repeated KeyValue.
180:     KeyValue.key = field 1 (string), KeyValue.value = field 2 (AnyValue).
181:     AnyValue.string_value = field 1.
182:     """
183:     for field, wire, payload, _s, _e in iter_fields(resource):
184:         if field != 1 or wire != 2:
185:             continue
186:         key = value = None
187:         for kf, kw, kp, _ks, _ke in iter_fields(payload):
188:             if kf == 1 and kw == 2:
189:                 key = kp
190:             elif kf == 2 and kw == 2:
191:                 for af, aw, ap, _as, _ae in iter_fields(kp):
192:                     if af == 1 and aw == 2:
193:                         value = ap
194:                         break
195:         if key == b'service.name' and value:
196:             try:
197:                 return value.decode('utf8').strip()
198:             except UnicodeDecodeError:
199:                 return ''
200:     return ''
201: 
202: 
203: def count_spans(resource_spans: bytes) -> int:
204:     """ResourceSpans.scope_spans = field 2; ScopeSpans.spans = field 2."""
205:     total = 0
206:     for field, wire, payload, _s, _e in iter_fields(resource_spans):
207:         if field == 2 and wire == 2:
208:             for sf, sw, _sp, _ss, _se in iter_fields(payload):
209:                 if sf == 2 and sw == 2:
210:                     total += 1
211:     return total
212: 
213: 
214: # --------------------------------------------------------------------------- limiter
215: 
216: class RateGuard:
217:     """One token bucket per service. Refills continuously; never blocks a thread."""
218: 
219:     def __init__(self, per_min: int, overrides: dict[str, int], clock=time.monotonic):
220:         self.per_min = per_min
221:         self.overrides = overrides
222:         self.clock = clock
223:         self.lock = threading.Lock()
224:         self.state: dict[str, tuple[float, float]] = {}
225: 
226:     def limit_for(self, service: str) -> int:
227:         return self.overrides.get(service, self.per_min)
228: 
229:     def allow(self, service: str, spans: int) -> bool:
230:         limit = self.limit_for(service)
231:         if limit <= 0:
232:             return False
233:         now = self.clock()
234:         with self.lock:
235:             tokens, last = self.state.get(service, (float(limit), now))
236:             tokens = min(float(limit), tokens + (now - last) * (limit / 60.0))
237:             if tokens >= spans:
238:                 self.state[service] = (tokens - spans, now)
239:                 return True
240:             self.state[service] = (tokens, now)
241:             return False
242: 
243: 
244: # --------------------------------------------------------------------------- filtering
245: 
246: class Decision:
247:     __slots__ = ('body', 'kept', 'dropped')
248: 
249:     def __init__(self, body: bytes, kept: dict, dropped: dict):
250:         self.body = body
251:         self.kept = kept
252:         self.dropped = dropped
253: 
254: 
255: def filter_payload(body: bytes, guard: RateGuard, known=KNOWN_SERVICES,
256:                    blocked=BLOCKED_SERVICES) -> Decision:
257:     """Keep only named, allowed, in-budget ResourceSpans. Re-emit valid OTLP."""
258:     kept_counts: dict[str, int] = collections.Counter()
259:     dropped: dict[str, int] = collections.Counter()
260:     out = bytearray()
261:     for field, wire, payload, _s, _e in iter_fields(body):
262:         if field != 1 or wire != 2:
263:             continue  # ExportTraceServiceRequest.resource_spans only
264:         resource = b''
265:         for rf, rw, rp, _rs, _re in iter_fields(payload):
266:             if rf == 1 and rw == 2:
267:                 resource = rp
268:                 break
269:         service = service_name_of(resource)
270:         spans = count_spans(payload)
271:         if not service:
272:             dropped['(unnamed)'] += spans
273:             continue
274:         if service in blocked:
275:             dropped[f'blocked:{service}'] += spans
276:             continue
277:         if known and service not in known:
278:             dropped[f'unknown:{service}'] += spans
279:             continue
280:         if not guard.allow(service, spans):
281:             dropped[f'throttled:{service}'] += spans
282:             continue
283:         kept_counts[service] += spans
284:         out += delimited(1, payload)
285:     return Decision(bytes(out), dict(kept_counts), dict(dropped))
286: 
287: 
288: # --------------------------------------------------------------------------- upstreams
289: 
290: def _run(cmd: list[str], env: dict | None = None) -> str:
291:     """Run a command, returning stdout. stderr is dropped: it could hold a key.
292: 
293:     Every subprocess failure, a timeout included, becomes a Blocked carrying no
294:     payload. Before this, a TimeoutExpired escaped as an unhandled traceback: it
295:     killed the process and printed the command line into the job log, and KeepAlive
296:     then relaunched it while still reporting "state = running".
297:     """
298:     try:
299:         proc = subprocess.run(cmd, capture_output=True, text=True, env=env,
300:                               timeout=HELPER_TIMEOUT)
301:     except subprocess.TimeoutExpired:
302:         raise Blocked(f'{Path(cmd[0]).name} did not answer within {HELPER_TIMEOUT}s') from None
303:     except subprocess.SubprocessError:
304:         raise Blocked(f'{Path(cmd[0]).name} could not be run') from None
305:     if proc.returncode:
306:         raise Blocked(f'{Path(cmd[0]).name} failed (exit {proc.returncode}); output withheld')
307:     return proc.stdout.strip()
308: 
309: 
310: # The proven credential path, reused rather than reimplemented.
311: #
312: # The hang I spent hours on is documented in op_items.robot_env: "Under the real HOME,
313: # op 2.39.0 on Alex's MacBook stalls for minutes before any network step; with a private
314: # HOME it answers in about a second". It also records that OP_BIOMETRIC_UNLOCK_ENABLED
315: # and OP_CACHE alone do NOT stop it. I had set exactly those two and passed the real
316: # HOME, which is why every launchd read timed out and why macOS kept asking Alex to let
317: # "op" reach other apps: with the real HOME, op goes near the 1Password app's data.
318: #
319: # robot_env gives op a private HOME, OP_CONFIG_DIR and TMPDIR under
320: # ~/.agents/runtime/op-robot, drops XDG_RUNTIME_DIR, and lets one `op daemon` serve every
321: # robot call. Nothing here is hand-rolled any more.
322: #
323: # On top of that, finished headers are cached in the login Keychain, the same pattern
324: # langfuse_otel_headers.py added on 2026-10-15 after 7,200 op calls a day starved every
325: # other op tool. `security` works fine under launchd and never prompts, so the common
326: # path touches 1Password not at all.
327: CONNECTORS = Path.home() / '.agents/tools/connectors'
328: LANGFUSE_HELPER = CONNECTORS / 'langfuse_otel_headers.py'
329: SECURITY = '/usr/bin/security'
330: CACHE_ACCOUNT = 'connectors-sync'
331: CACHE_TTL_SECONDS = 12 * 3600
332: SIGNOZ_CACHE_SERVICE = 'signoz-ingestion-header-cache'
333: ROBOT_TOKEN_SERVICE = 'op-service-account-connectors-sync'
334: # A single read gets a SHORT ceiling on purpose. A long one is worse than useless when
335: # the failure mode is a modal dialog waiting on a human: it holds the prompt on screen.
336: # A healthy robot call answers in about a second.
337: OP_READ_TIMEOUT = 10
338: 
339: 
340: def _load_op_items():
341:     """Import the shared op_items module from ~/.agents. Read-only use of their code."""
342:     import importlib.util
343:     spec = importlib.util.spec_from_file_location('op_items', CONNECTORS / 'op_items.py')
344:     if spec is None or spec.loader is None:
345:         raise Blocked('op_items.py not found; cannot read credentials the proven way')
346:     module = importlib.util.module_from_spec(spec)
347:     spec.loader.exec_module(module)
348:     return module
349: 
350: 
351: def _keychain_get(service: str) -> dict | None:
352:     proc = subprocess.run([SECURITY, 'find-generic-password', '-a', CACHE_ACCOUNT,
353:                            '-s', service, '-w'], capture_output=True, text=True,
354:                           timeout=OP_READ_TIMEOUT)
355:     if proc.returncode:
356:         return None
357:     try:
358:         held = json.loads(proc.stdout.strip())
359:     except ValueError:
360:         return None
361:     if not isinstance(held, dict) or time.time() - float(held.get('ts', 0)) >= CACHE_TTL_SECONDS:
362:         return None
363:     headers = held.get('headers')
364:     return headers if isinstance(headers, dict) and headers else None
365: 
366: 
367: def _keychain_put(service: str, headers: dict) -> None:
368:     # security(1) -i reads its command from stdin, so no credential rides in argv.
369:     import shlex
370:     command = ['add-generic-password', '-U', '-a', CACHE_ACCOUNT, '-s', service, '-w',
371:                json.dumps({'ts': time.time(), 'headers': headers})]
372:     subprocess.run([SECURITY, '-i'], input=shlex.join(command) + '\n',
373:                    capture_output=True, text=True, timeout=OP_READ_TIMEOUT)
374: 
375: 
376: def _robot_token() -> str:
377:     proc = subprocess.run([SECURITY, 'find-generic-password', '-a', CACHE_ACCOUNT,
378:                            '-s', ROBOT_TOKEN_SERVICE, '-w'], capture_output=True, text=True,
379:                           timeout=OP_READ_TIMEOUT)
380:     if proc.returncode or not proc.stdout.strip():
381:         raise Blocked('the robot service-account token is not readable')
382:     return proc.stdout.strip()
383: 
384: 
385: def signoz_headers() -> dict:
386:     """SigNoz ingestion header, Keychain-cached, read through robot_env on a miss."""
387:     cached = _keychain_get(SIGNOZ_CACHE_SERVICE)
388:     if cached:
389:         return cached
390:     op_items = _load_op_items()
391:     token = _robot_token()
392:     with op_items.robot_env(token) as env:
393:         proc = subprocess.run(['op', 'read', SIGNOZ_OP_REF], capture_output=True, text=True,
394:                               env=env, stdin=subprocess.DEVNULL, timeout=OP_READ_TIMEOUT)
395:     if proc.returncode or not proc.stdout.strip():
396:         raise Blocked('the SigNoz key could not be read from 1Password')
397:     key = proc.stdout.strip()
398:     if '\n' in key or '\r' in key:
399:         raise Blocked('the SigNoz key does not have the expected shape')
400:     headers = {SIGNOZ_HEADER: key}
401:     _keychain_put(SIGNOZ_CACHE_SERVICE, headers)
402:     return headers
403: 
404: 
405: def langfuse_headers() -> dict:
406:     """Langfuse headers from the EXISTING helper, which already owns its own 12h cache."""
407:     if not LANGFUSE_HELPER.exists():
408:         raise Blocked('the Langfuse header helper is missing')
409:     proc = subprocess.run([sys.executable, '-B', str(LANGFUSE_HELPER)], capture_output=True,
410:                           text=True, stdin=subprocess.DEVNULL, timeout=OP_READ_TIMEOUT)
411:     if proc.returncode:
412:         raise Blocked('the Langfuse header helper would not answer')
413:     try:
414:         headers = json.loads(proc.stdout.strip())
415:     except ValueError:
416:         raise Blocked('the Langfuse header helper returned nothing usable') from None
417:     if not isinstance(headers, dict) or 'Authorization' not in headers:
418:         raise Blocked('the Langfuse header helper returned no Authorization')
419:     return headers
420: 
421: 
422: def auth_for(name: str) -> str:
423:     """Header VALUE for one upstream. Never print or log the return value."""
424:     if name == 'signoz':
425:         return signoz_headers()[SIGNOZ_HEADER]
426:     if name == 'langfuse':
427:         return langfuse_headers()['Authorization']
428:     raise Blocked(f'no credential route for upstream {name}')
429: 
430: 
431: class KeyCache:
432:     """Holds each upstream's auth header, and refuses to hammer 1Password for it.
433: 
434:     The backoff is the important part. The 1Password service account is shared by
435:     every agent on this Mac and has a daily read cap. On 2026-10-20 this collector
436:     read three secrets per launch, crashed on a slow read, and launchd's KeepAlive
437:     relaunched it: the loop exhausted the account's authenticated path for everyone
438:     until the reads stopped. So a failed read now blocks further attempts for an
439:     exponentially growing interval, and a caller gets an immediate refusal instead
440:     of a new subprocess.
441:     """
442: 
443:     def __init__(self, names: list[str], ttl: int = KEY_TTL):
444:         self.names = names
445:         self.ttl = ttl
446:         self.lock = threading.Lock()
447:         self.cache: dict[str, tuple[str, float]] = {}
448:         self.failures: dict[str, int] = {}
449:         self.blocked_until: dict[str, float] = {}
450: 
451:     def backoff_for(self, failures: int) -> float:
452:         return min(KEY_BACKOFF_BASE * (2 ** max(failures - 1, 0)), KEY_BACKOFF_MAX)
453: 
454:     def get(self, name: str) -> str:
455:         now = time.monotonic()
456:         with self.lock:
457:             hit = self.cache.get(name)
458:             if hit and now - hit[1] < self.ttl:
459:                 return hit[0]
460:             wait = self.blocked_until.get(name, 0.0) - now
461:             if wait > 0:
462:                 raise Blocked(f'{name} key unavailable; not retrying for {wait:.0f}s')
463:         try:
464:             value = auth_for(name)
465:         except Blocked:
466:             with self.lock:
467:                 self.failures[name] = self.failures.get(name, 0) + 1
468:                 delay = self.backoff_for(self.failures[name])
469:                 self.blocked_until[name] = time.monotonic() + delay
470:                 count = self.failures[name]
471:             print(f'  {name} key read failed ({count} in a row); holding off {delay:.0f}s '
472:                   f'so 1Password is not hammered', file=sys.stderr)
473:             sys.stderr.flush()
474:             raise
475:         with self.lock:
476:             self.cache[name] = (value, time.monotonic())
477:             self.failures.pop(name, None)
478:             self.blocked_until.pop(name, None)
479:         return value
480: 
481:     def peek(self, name: str) -> str:
482:         """Cached value only. NEVER calls 1Password, so it cannot block a request.
483: 
484:         The request path must not wait on a credential: on 2026-10-20 a span arriving
485:         while the keys were cold held the HTTP handler for 90 seconds and the sender
486:         timed out. A span that cannot be forwarded right now is counted and dropped,
487:         which is visible in /stats, instead of stalling whoever sent it. The
488:         background warmer is the only thing that calls out to 1Password.
489:         """
490:         with self.lock:
491:             hit = self.cache.get(name)
492:             if hit and time.monotonic() - hit[1] < self.ttl:
493:                 return hit[0]
494:         raise Blocked(f'{name} key not cached yet')
495: 
496:     def drop(self, name: str) -> None:
497:         with self.lock:
498:             self.cache.pop(name, None)
499: 
500: 
501: def forward(name: str, body: bytes, keys: KeyCache) -> int:
502:     url, header = UPSTREAMS[name]
503:     from urllib.parse import urlsplit
504:     if urlsplit(url).hostname not in ALLOWED_HOSTS:
505:         raise Blocked('refused: upstream host is not in ALLOWED_HOSTS')
506:     headers = {'Content-Type': 'application/x-protobuf', header: keys.peek(name)}
507:     if name == 'langfuse':
508:         headers['x-langfuse-ingestion-version'] = '4'
509:     req = urllib.request.Request(url, data=body, headers=headers, method='POST')
510:     try:
511:         with urllib.request.urlopen(req, timeout=IO_TIMEOUT) as resp:
512:             resp.read(64 * 1024)
513:             return resp.status
514:     except urllib.error.HTTPError as err:
515:         err.read(4096)
516:         if err.code in (401, 403):
517:             keys.drop(name)  # a rotated key should not stay rejected until the TTL
518:         return err.code
519:     except urllib.error.URLError:
520:         return 0  # network failure; never surface the reason, it can carry a URL with auth
521: 
522: 
523: # --------------------------------------------------------------------------- server
524: 
525: class Stats:
526:     def __init__(self):
527:         self.lock = threading.Lock()
528:         self.kept = collections.Counter()
529:         self.dropped = collections.Counter()
530:         self.upstream = collections.Counter()
531:         self.started = time.time()
532: 
533:     def add(self, decision: Decision, statuses: dict[str, int]):
534:         with self.lock:
535:             self.kept.update(decision.kept)
536:             self.dropped.update(decision.dropped)
537:             for name, status in statuses.items():
538:                 self.upstream[f'{name}:{status}'] += 1
539: 
540:     def snapshot(self) -> dict:
541:         with self.lock:
542:             hours = max((time.time() - self.started) / 3600, 1 / 3600)
543:             return {
544:                 'uptime_hours': round(hours, 3),
545:                 'kept_spans': dict(self.kept),
546:                 'kept_spans_per_hour': {k: round(v / hours) for k, v in self.kept.items()},
547:                 'dropped_spans': dict(self.dropped),
548:                 'upstream_responses': dict(self.upstream),
549:             }
550: 
551: 
552: def is_loopback(host: str) -> bool:
553:     try:
554:         return ipaddress.ip_address(host).is_loopback
555:     except ValueError:
556:         return False
557: 
558: 
559: class Collector(ThreadingHTTPServer):
560:     daemon_threads = True
561:     allow_reuse_address = True
562: 
563:     def __init__(self, address, *, upstreams: list[str], guard: RateGuard,
564:                  keys: KeyCache, dry_run: bool, log_path: Path | None):
565:         super().__init__(address, Handler)
566:         self.upstreams = upstreams
567:         self.guard = guard
568:         self.keys = keys
569:         self.dry_run = dry_run
570:         self.log_path = log_path
571:         self.stats = Stats()
572: 
573:     def log_row(self, row: dict) -> None:
574:         if not self.log_path:
575:             return
576:         try:
577:             with open(self.log_path, 'a') as handle:
578:                 handle.write(json.dumps(row) + '\n')
579:         except OSError:
580:             pass  # best effort: never fail a request because the log is unwritable
581: 
582: 
583: class Handler(BaseHTTPRequestHandler):
584:     protocol_version = 'HTTP/1.1'
585: 
586:     def log_message(self, *args):
587:         pass  # the request line could carry a query string; never log it
588: 
589:     def _reply(self, status: int, body: bytes = b'') -> None:
590:         self.send_response(status)
591:         self.send_header('Content-Length', str(len(body)))
592:         self.end_headers()
593:         if body:
594:             self.wfile.write(body)
595: 
596:     def do_GET(self):
597:         if self.path == '/stats':
598:             body = json.dumps(self.server.stats.snapshot(), indent=2).encode()
599:             self.send_response(200)
600:             self.send_header('Content-Type', 'application/json')
601:             self.send_header('Content-Length', str(len(body)))
602:             self.end_headers()
603:             self.wfile.write(body)
604:             return
605:         self._reply(404)
606: 
607:     def do_POST(self):
608:         if not is_loopback(self.client_address[0]):
609:             self._reply(403)
610:             return
611:         if self.path != '/v1/traces':
612:             self._reply(404)
613:             return
614:         try:
615:             length = int(self.headers.get('Content-Length') or 0)
616:         except ValueError:
617:             self._reply(400)
618:             return
619:         if length <= 0 or length > MAX_BODY:
620:             self._reply(413 if length > MAX_BODY else 400)
621:             return
622:         body = self.rfile.read(length)
623:         try:
624:             decision = filter_payload(body, self.server.guard)
625:         except ValueError:
626:             self._reply(400)
627:             return
628: 
629:         statuses: dict[str, int] = {}
630:         if decision.body and not self.server.dry_run:
631:             for name in self.server.upstreams:
632:                 try:
633:                     statuses[name] = forward(name, decision.body, self.server.keys)
634:                 except Blocked:
635:                     statuses[name] = -1
636:         self.server.stats.add(decision, statuses)
637:         self.server.log_row({
638:             'ts': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
639:             'bytes_in': length, 'kept': decision.kept, 'dropped': decision.dropped,
640:             'upstream': statuses, 'dry_run': self.server.dry_run,
641:         })
642:         self._reply(200 if (not statuses or any(s == 200 for s in statuses.values())) else 502)
643: 
644: 
645: # --------------------------------------------------------------------------- self test
646: 
647: def self_test() -> int:
648:     """No network, no listener. Proves the filter does what the docstring claims."""
649:     import struct
650: 
651:     def kvbody(key: str, val: str) -> bytes:
652:         return delimited(1, key.encode()) + delimited(2, delimited(1, val.encode()))
653: 
654:     def span(name: str) -> bytes:
655:         now = time.time_ns()
656:         return b''.join([
657:             delimited(1, b'\x11' * 16), delimited(2, b'\x22' * 8), delimited(5, name.encode()),
658:             varint((6 << 3) | 0) + varint(1),
659:             varint((7 << 3) | 1) + struct.pack('<Q', now),
660:             varint((8 << 3) | 1) + struct.pack('<Q', now + 1000),
661:         ])
662: 
663:     def resource_spans(service: str | None, n: int) -> bytes:
664:         resource = delimited(1, kvbody('service.name', service)) if service is not None else b''
665:         scope = delimited(2, b''.join(delimited(2, span(f's{i}')) for i in range(n)))
666:         return delimited(1, delimited(1, resource) + scope)
667: 
668:     checks: list[tuple[str, bool, str]] = []
669: 
670:     def check(name: str, ok: bool, detail: str = ''):
671:         checks.append((name, bool(ok), detail))
672: 
673:     guard = RateGuard(DEFAULT_RATE_PER_MIN, {})
674:     d = filter_payload(resource_spans('claude-code', 3), guard)
675:     check('named service kept', d.kept == {'claude-code': 3} and len(d.body) > 0)
676: 
677:     d = filter_payload(resource_spans(None, 2), RateGuard(600, {}))
678:     check('resource with no attributes dropped', d.dropped == {'(unnamed)': 2} and d.body == b'')
679: 
680:     d = filter_payload(resource_spans('', 2), RateGuard(600, {}))
681:     check('empty service.name dropped', d.dropped == {'(unnamed)': 2} and d.body == b'')
682: 
683:     d = filter_payload(resource_spans('codex-worker', 5), RateGuard(600, {}))
684:     check('blocked service refused', d.dropped == {'blocked:codex-worker': 5} and d.body == b'')
685: 
686:     d = filter_payload(resource_spans('typo-agent', 1), RateGuard(600, {}))
687:     check('unknown name counted, not silently kept', d.dropped == {'unknown:typo-agent': 1})
688: 
689:     # The flood case: labelled, known, but far over budget.
690:     tiny = RateGuard(10, {})
691:     first = filter_payload(resource_spans('claude-code', 10), tiny)
692:     second = filter_payload(resource_spans('claude-code', 10), tiny)
693:     check('rate guard passes the first burst', first.kept == {'claude-code': 10})
694:     check('rate guard throttles the flood', second.dropped == {'throttled:claude-code': 10})
695: 
696:     # One over-budget service must not starve another.
697:     shared = RateGuard(10, {})
698:     filter_payload(resource_spans('claude-code', 10), shared)
699:     other = filter_payload(resource_spans('codex', 5), shared)
700:     check('one sender cannot starve another', other.kept == {'codex': 5})
701: 
702:     mixed = filter_payload(
703:         resource_spans('claude-code', 1) + resource_spans(None, 4) + resource_spans('codex', 2),
704:         RateGuard(600, {}))
705:     check('mixed batch keeps the named and drops the rest',
706:           mixed.kept == {'claude-code': 1, 'codex': 2} and mixed.dropped == {'(unnamed)': 4})
707:     check('re-emitted body is parseable OTLP',
708:           filter_payload(mixed.body, RateGuard(600, {})).kept == {'claude-code': 1, 'codex': 2})
709: 
710:     check('loopback check rejects a public address', not is_loopback('8.8.8.8'))
711:     check('loopback check accepts 127.0.0.1', is_loopback('127.0.0.1'))
712: 
713:     # The amplifier fix. These exist because on 2026-10-20 this collector exhausted the
714:     # shared 1Password service account by reading keys inside a KeepAlive restart loop.
715:     calls = {'n': 0}
716:     real_auth = globals()['auth_for']
717: 
718:     def counting_auth(name):
719:         calls['n'] += 1
720:         raise Blocked('simulated 1Password failure')
721: 
722:     globals()['auth_for'] = counting_auth
723:     try:
724:         cache = KeyCache(['signoz'])
725:         refusals = []
726:         for _ in range(5):
727:             try:
728:                 cache.get('signoz')
729:             except Blocked as err:
730:                 refusals.append(str(err))
731:         check('five requests cause ONE call to 1Password, not five',
732:               calls['n'] == 1, f'calls made: {calls["n"]}')
733:         check('later requests are refused without calling out',
734:               len(refusals) == 5 and any('not retrying' in r for r in refusals[1:]),
735:               f'refusals: {refusals[1:2]}')
736:         check('backoff grows with consecutive failures',
737:               cache.backoff_for(1) < cache.backoff_for(3) < cache.backoff_for(9))
738:         check('backoff is capped', cache.backoff_for(99) == KEY_BACKOFF_MAX,
739:               f'{cache.backoff_for(99)} vs {KEY_BACKOFF_MAX}')
740: 
741:         # A key that starts working must clear the hold immediately.
742:         cache2 = KeyCache(['signoz'])
743:         try:
744:             cache2.get('signoz')
745:         except Blocked:
746:             pass
747:         globals()['auth_for'] = lambda name: 'test-header-value'
748:         cache2.blocked_until['signoz'] = 0.0  # as if the hold had elapsed
749:         check('a recovered key is cached and the failure count resets',
750:               cache2.get('signoz') == 'test-header-value'
751:               and 'signoz' not in cache2.failures)
752: 
753:         # The request path must never wait on 1Password.
754:         before = calls['n']
755:         globals()['auth_for'] = counting_auth
756:         cold = KeyCache(['signoz'])
757:         try:
758:             cold.peek('signoz')
759:             peeked = 'returned a value it should not have'
760:         except Blocked:
761:             peeked = 'refused'
762:         check('peek on a cold cache refuses instead of blocking', peeked == 'refused', peeked)
763:         check('peek makes NO call to 1Password', calls['n'] == before,
764:               f'calls before {before}, after {calls["n"]}')
765:     finally:
766:         globals()['auth_for'] = real_auth
767: 
768:     width = max(len(n) for n, _ok, _d in checks)
769:     for name, ok, detail in checks:
770:         line = f'  {"pass" if ok else "FAIL"}  {name:{width}}'
771:         print(line if ok else line + f'   <- {detail}')
772:     failed = [n for n, ok, _d in checks if not ok]
773:     print()
774:     print(f'{len(checks) - len(failed)}/{len(checks)} checks passed')
775:     return 1 if failed else 0
776: 
777: 
778: def main(argv: list[str] | None = None) -> int:
779:     parser = argparse.ArgumentParser(description=__doc__,
780:                                      formatter_class=argparse.RawDescriptionHelpFormatter)
781:     parser.add_argument('--port', type=int, default=4320)
782:     parser.add_argument('--upstream', action='append', choices=sorted(UPSTREAMS),
783:                         help='repeatable; omit with --dry-run to forward nowhere')
784:     parser.add_argument('--dry-run', action='store_true',
785:                         help='accept, filter and count, but forward nothing')
786:     parser.add_argument('--rate-per-min', type=int, default=DEFAULT_RATE_PER_MIN)
787:     parser.add_argument('--log', default=None, help='JSONL path for per-request counts')
788:     parser.add_argument('--self-test', action='store_true')
789:     args = parser.parse_args(argv)
790: 
791:     if args.self_test:
792:         return self_test()
793: 
794:     upstreams = args.upstream or []
795:     if not upstreams and not args.dry_run:
796:         print('Refusing to start: pass --upstream, or --dry-run to forward nothing.',
797:               file=sys.stderr)
798:         return 2
799: 
800:     guard = RateGuard(args.rate_per_min, RATE_OVERRIDES)
801:     keys = KeyCache(upstreams)
802: 
803:     # Under launchd a stop arrives as SIGTERM, not KeyboardInterrupt. shutdown() cannot
804:     # be called from the serving thread, so the handler only sets this flag and the main
805:     # thread closes the listener and lets in-flight requests finish. Declared here
806:     # because the key-warming thread waits on it too.
807:     stop = threading.Event()
808: 
809:     server = Collector(('127.0.0.1', args.port), upstreams=upstreams, guard=guard, keys=keys,
810:                        dry_run=args.dry_run, log_path=Path(args.log) if args.log else None)
811:     print(f'  listening on 127.0.0.1:{server.server_address[1]}/v1/traces')
812:     print(f'  upstreams: {", ".join(upstreams) or "(none, dry run)"}')
813:     print(f'  rate guard: {args.rate_per_min} spans/min per service')
814:     print(f'  blocked: {", ".join(BLOCKED_SERVICES)}')
815:     print(f'  counts: GET http://127.0.0.1:{server.server_address[1]}/stats')
816:     sys.stdout.flush()
817: 
818:     # Keys are warmed in the BACKGROUND, after the listener is already bound. Reading
819:     # them first was a design bug: on 2026-10-20 a slow `op read` under launchd held the
820:     # startup path for minutes, so the port never opened and the service looked dead
821:     # while the process was perfectly healthy. Binding first means /stats answers at
822:     # once, a span that cannot be forwarded is counted rather than lost, and the thing
823:     # is diagnosable from outside. KeyCache's backoff keeps the retries cheap.
824:     def warm_keys():
825:         for name in upstreams:
826:             while not stop.is_set():
827:                 try:
828:                     keys.get(name)
829:                     print(f'  {name} key read from 1Password (value not shown)')
830:                     sys.stdout.flush()
831:                     break
832:                 except Blocked as err:
833:                     print(f'  {name} key still unavailable: {err}', file=sys.stderr)
834:                     sys.stderr.flush()
835:                     if stop.wait(KEY_BACKOFF_BASE):
836:                         return
837: 
838:     if upstreams and not args.dry_run:
839:         threading.Thread(target=warm_keys, daemon=True, name='warm-keys').start()
840: 
841:     previous = {}
842:     worker = threading.Thread(target=server.serve_forever, kwargs={'poll_interval': 0.5})
843:     try:
844:         for sig in (signal.SIGTERM, signal.SIGINT):
845:             previous[sig] = signal.signal(sig, lambda *_: stop.set())
846:         worker.start()
847:         stop.wait()
848:     finally:
849:         if worker.is_alive():
850:             server.shutdown()
851:             worker.join(timeout=10)
852:         server.server_close()
853:         for sig, handler in previous.items():
854:             signal.signal(sig, handler)
855:     # The final counts go to stdout, which launchd captures in the job's log.
856:     print(json.dumps(server.stats.snapshot(), indent=2))
857:     sys.stdout.flush()
858:     return 0
859: 
860: 
861: if __name__ == '__main__':
862:     sys.exit(main())

