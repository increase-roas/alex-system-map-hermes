FILE: reviews/receipts/20261020-p4-apply/evidence/11-the-hostile-verifier.py
1: #!/usr/bin/env python3
2: """Prove the collector LaunchAgent is real: loaded, answering, surviving, and delivering.
3: 
4: Run this AFTER the job is bootstrapped. It is the acceptance test for
5: absence-alarms-20261020-p4-collector-durable, and it is deliberately hostile: a
6: "loaded" line from launchctl is a claim, not proof, so every check here either reads
7: live state or makes something happen.
8: 
9: Checks, in order:
10:   1. launchctl reports the job with a real PID (not just present, running)
11:   2. the PID is the one actually holding port 4320
12:   3. GET /stats answers from a FRESH process, so nothing depends on this shell
13:   4. the 1Password read happened inside launchd, proven by a successful SigNoz send
14:      rather than by reading a key
15:   5. a named canary through the collector arrives in SigNoz as the right service
16:   6. an unnamed canary is dropped, with the drop visible in the collector's counts
17:   7. the job comes back by itself after being killed (KeepAlive really works)
18: 
19: Run: python3 -B work/signoz-relay/verify_durable.py
20:      python3 -B work/signoz-relay/verify_durable.py --skip-restart   (leave step 7 out)
21: """
22: from __future__ import annotations
23: 
24: import argparse
25: import datetime as dt
26: import json
27: import os
28: import re
29: import secrets
30: import struct
31: import subprocess
32: import sys
33: import time
34: import urllib.error
35: import urllib.request
36: 
37: LABEL = 'com.alex.signoz-collector'
38: PORT = 4320
39: SIGNOZ_BASE = 'https://pet-mammoth.us2.signoz.cloud'
40: READ_KEY_REF = 'op://Connectors/ergsvtc63iqob4g7itsr7lpr64/credential'
41: OP_BIN = '/opt/homebrew/bin/op'
42: 
43: CHECKS: list[tuple[str, bool, str]] = []
44: 
45: 
46: def check(name: str, ok: bool, detail: str = '') -> None:
47:     CHECKS.append((name, bool(ok), detail))
48:     print(f'  {"pass" if ok else "FAIL"}  {name}' + (f'   <- {detail}' if detail else ''))
49: 
50: 
51: def sh(cmd: list[str], timeout: int = 45) -> tuple[int, str]:
52:     proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
53:     return proc.returncode, (proc.stdout or '') + (proc.stderr or '')
54: 
55: 
56: def launchctl_pid() -> int | None:
57:     code, out = sh(['launchctl', 'print', f'gui/{os.getuid()}/{LABEL}'])
58:     if code:
59:         return None
60:     match = re.search(r'^\s*pid\s*=\s*(\d+)', out, re.M)
61:     return int(match.group(1)) if match else None
62: 
63: 
64: def port_holder() -> int | None:
65:     code, out = sh(['lsof', '-nP', f'-iTCP:{PORT}'])
66:     for line in out.splitlines()[1:]:
67:         parts = line.split()
68:         if len(parts) > 1 and 'LISTEN' in line:
69:             try:
70:                 return int(parts[1])
71:             except ValueError:
72:                 continue
73:     return None
74: 
75: 
76: def stats_from_fresh_process() -> dict | None:
77:     """Deliberately a separate interpreter: proves nothing is held open by this shell."""
78:     code, out = sh([sys.executable, '-c',
79:                     f'import urllib.request,sys;'
80:                     f'sys.stdout.write(urllib.request.urlopen('
81:                     f'"http://127.0.0.1:{PORT}/stats", timeout=15).read().decode())'])
82:     if code:
83:         return None
84:     try:
85:         return json.loads(out)
86:     except json.JSONDecodeError:
87:         return None
88: 
89: 
90: # --- OTLP ---------------------------------------------------------------------
91: 
92: def _varint(n: int) -> bytes:
93:     out = bytearray()
94:     while True:
95:         b = n & 0x7F
96:         n >>= 7
97:         out.append(b | (0x80 if n else 0))
98:         if not n:
99:             return bytes(out)
100: 
101: 
102: def _k(f: int, w: int) -> bytes:
103:     return _varint((f << 3) | w)
104: 
105: 
106: def _d(f: int, p: bytes) -> bytes:
107:     return _k(f, 2) + _varint(len(p)) + p
108: 
109: 
110: def _kv(key: str, val: str) -> bytes:
111:     return _d(1, key.encode()) + _d(2, _d(1, val.encode()))
112: 
113: 
114: def payload(service, name: str, trace_id: bytes, host: str = 'macbook') -> bytes:
115:     now = time.time_ns()
116:     span = b''.join([
117:         _d(1, trace_id), _d(2, secrets.token_bytes(8)), _d(5, name.encode()),
118:         _k(6, 0) + _varint(1),
119:         _k(7, 1) + struct.pack('<Q', now),
120:         _k(8, 1) + struct.pack('<Q', now + 2_000_000),
121:         _d(9, _kv('check', 'p4 durability acceptance')),
122:     ])
123:     resource = b''
124:     if service:
125:         resource = _d(1, _kv('service.name', service)) + _d(1, _kv('host.name', host))
126:     # ResourceSpans body = resource(field 1) + scope_spans(field 2); the whole thing
127:     # is then ONE field-1 wrapper (ExportTraceServiceRequest.resource_spans). An extra
128:     # wrapper here made every span parse as unnamed with a count of zero, and the
129:     # collector correctly refused it. Second time I have made this nesting mistake.
130:     return _d(1, _d(1, resource) + _d(2, _d(2, span)))
131: 
132: 
133: def post(body: bytes) -> int:
134:     req = urllib.request.Request(f'http://127.0.0.1:{PORT}/v1/traces', data=body,
135:                                  method='POST',
136:                                  headers={'Content-Type': 'application/x-protobuf'})
137:     try:
138:         with urllib.request.urlopen(req, timeout=40) as resp:
139:             return resp.status
140:     except urllib.error.HTTPError as err:
141:         return err.code
142:     except urllib.error.URLError:
143:         return 0
144: 
145: 
146: def read_key() -> str:
147:     code, token = sh(['/usr/bin/security', 'find-generic-password', '-a', 'connectors-sync',
148:                       '-s', 'op-service-account-connectors-sync', '-w'])
149:     if code:
150:         raise SystemExit('could not read the service account token')
151:     # Through op_items.robot_env, not the real HOME. Under the real HOME op stalls for
152:     # minutes before any network step and makes macOS prompt for app data access; this
153:     # script hit that itself after the collector had already been fixed for it.
154:     import importlib.util
155:     spec = importlib.util.spec_from_file_location(
156:         'op_items', os.path.expanduser('~/.agents/tools/connectors/op_items.py'))
157:     op_items = importlib.util.module_from_spec(spec)
158:     spec.loader.exec_module(op_items)
159:     with op_items.robot_env(token.strip()) as env:
160:         proc = subprocess.run([OP_BIN, 'read', READ_KEY_REF], capture_output=True, text=True,
161:                               env=env, stdin=subprocess.DEVNULL, timeout=15)
162:     if proc.returncode:
163:         raise SystemExit('could not read the SigNoz read key')
164:     return proc.stdout.strip()
165: 
166: 
167: def signoz_service(key: str, trace_id: str):
168:     req = urllib.request.Request(f'{SIGNOZ_BASE}/api/v1/traces/{trace_id}',
169:                                  headers={'SIGNOZ-API-KEY': key, 'Accept': 'application/json'})
170:     try:
171:         with urllib.request.urlopen(req, timeout=40) as resp:
172:             rows = json.loads(resp.read())
173:     except Exception:
174:         return None
175:     if not rows or not rows[0].get('events'):
176:         return None
177:     cols = rows[0]['columns']
178:     return rows[0]['events'][0][cols.index('ServiceName')]
179: 
180: 
181: def main() -> int:
182:     parser = argparse.ArgumentParser()
183:     parser.add_argument('--skip-restart', action='store_true')
184:     parser.add_argument('--wait', type=int, default=60)
185:     args = parser.parse_args()
186: 
187:     print(f'verifying {LABEL} at {dt.datetime.now(dt.timezone.utc):%Y-%m-%dT%H:%M:%SZ}\n')
188: 
189:     pid = launchctl_pid()
190:     check('launchctl reports the job with a live PID', pid is not None, f'pid={pid}')
191:     holder = port_holder()
192:     check(f'that same PID holds port {PORT}', pid is not None and holder == pid,
193:           f'launchctl pid={pid}, port holder={holder}')
194: 
195:     stats = stats_from_fresh_process()
196:     check('/stats answers from a separate process', stats is not None,
197:           'nothing answered' if stats is None else f'uptime {stats.get("uptime_hours")}h')
198:     if stats is None:
199:         print('\nThe collector is not answering. Everything below would be meaningless.')
200:         return 1
201:     before_kept = sum(stats.get('kept_spans', {}).values())
202: 
203:     stamp = dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
204:     named_id = secrets.token_bytes(16)
205:     unnamed_id = secrets.token_bytes(16)
206:     named_status = post(payload('alex-system-map', f'p4-durable-named-{stamp}', named_id))
207:     unnamed_status = post(payload(None, f'p4-durable-unnamed-{stamp}', unnamed_id))
208:     check('collector accepts a named span', named_status == 200, f'HTTP {named_status}')
209:     check('collector accepts and swallows an unnamed span', unnamed_status == 200,
210:           f'HTTP {unnamed_status}')
211:     time.sleep(2)
212: 
213:     after = stats_from_fresh_process() or {}
214:     kept_now = sum(after.get('kept_spans', {}).values())
215:     dropped_now = after.get('dropped_spans', {})
216:     check('the kept counter moved', kept_now > before_kept, f'{before_kept} -> {kept_now}')
217:     check('the drop counter shows the unnamed span',
218:           dropped_now.get('(unnamed)', 0) >= 1, f'dropped={dropped_now}')
219:     upstream = after.get('upstream_responses', {})
220:     check('SigNoz accepted it, so the key WAS read inside launchd',
221:           any(k.startswith('signoz:200') for k in upstream), f'upstream={upstream}')
222: 
223:     print(f'\n  waiting up to {args.wait}s for SigNoz to index')
224:     key = read_key()
225:     deadline = time.monotonic() + args.wait
226:     service = None
227:     while time.monotonic() < deadline:
228:         service = signoz_service(key, named_id.hex())
229:         if service:
230:             break
231:         time.sleep(10)
232:     check("named canary in SigNoz as 'alex-system-map'", service == 'alex-system-map',
233:           f'got {service!r}')
234:     check('unnamed canary absent from SigNoz',
235:           signoz_service(key, unnamed_id.hex()) is None)
236:     print(f'    trace: {SIGNOZ_BASE}/trace/{named_id.hex()}')
237: 
238:     if not args.skip_restart:
239:         print('\n  killing the process to prove KeepAlive brings it back')
240:         old = launchctl_pid()
241:         if old:
242:             sh(['kill', '-9', str(old)])
243:         new = None
244:         for _ in range(12):
245:             time.sleep(5)
246:             new = launchctl_pid()
247:             if new and new != old:
248:                 break
249:         check('KeepAlive restarted it with a new PID', bool(new) and new != old,
250:               f'{old} -> {new}')
251:         check('/stats answers again after the restart',
252:               stats_from_fresh_process() is not None)
253: 
254:     failed = [n for n, ok, _d in CHECKS if not ok]
255:     print(f'\n{len(CHECKS) - len(failed)}/{len(CHECKS)} checks passed')
256:     if failed:
257:         print('FAILED: ' + '; '.join(failed))
258:     return 1 if failed else 0
259: 
260: 
261: if __name__ == '__main__':
262:     sys.exit(main())

