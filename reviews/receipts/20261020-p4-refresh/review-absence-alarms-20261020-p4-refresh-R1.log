   435	
   436	class KeyCache:
   437	    """Holds each upstream's auth header, and refuses to hammer 1Password for it.
   438	
   439	    The backoff is the important part. The 1Password service account is shared by
   440	    every agent on this Mac and has a daily read cap. On 2026-10-20 this collector
   441	    read three secrets per launch, crashed on a slow read, and launchd's KeepAlive
   442	    relaunched it: the loop exhausted the account's authenticated path for everyone
   443	    until the reads stopped. So a failed read now blocks further attempts for an
   444	    exponentially growing interval, and a caller gets an immediate refusal instead
   445	    of a new subprocess.
   446	    """
   447	
   448	    def __init__(self, names: list[str], ttl: int = KEY_TTL, clock=time.monotonic):
   449	        self.names = names
   450	        self.ttl = ttl
   451	        self.clock = clock
   452	        self.lock = threading.Lock()
   453	        self.cache: dict[str, tuple[str, float]] = {}
   454	        self.failures: dict[str, int] = {}
   455	        self.blocked_until: dict[str, float] = {}
   456	
   457	    def backoff_for(self, failures: int) -> float:
   458	        return min(KEY_BACKOFF_BASE * (2 ** max(failures - 1, 0)), KEY_BACKOFF_MAX)
   459	
   460	    def get(self, name: str, force: bool = False) -> str:
   461	        """Cached value, or a read. force=True skips the cache hit (the refresh path)
   462	        but still honours the failure backoff."""
   463	        now = self.clock()
   464	        with self.lock:
   465	            hit = self.cache.get(name)
   466	            if hit and not force and now - hit[1] < self.ttl:
   467	                return hit[0]
   468	            wait = self.blocked_until.get(name, 0.0) - now
   469	            if wait > 0:
   470	                raise Blocked(f'{name} key unavailable; not retrying for {wait:.0f}s')
   471	        try:
   472	            value = auth_for(name)
   473	        except Blocked:
   474	            with self.lock:
   475	                self.failures[name] = self.failures.get(name, 0) + 1
   476	                delay = self.backoff_for(self.failures[name])
   477	                self.blocked_until[name] = self.clock() + delay
   478	                count = self.failures[name]
   479	            print(f'  {name} key read failed ({count} in a row); holding off {delay:.0f}s '
   480	                  f'so 1Password is not hammered', file=sys.stderr)
   481	            sys.stderr.flush()
   482	            raise
   483	        with self.lock:
   484	            self.cache[name] = (value, self.clock())
   485	            self.failures.pop(name, None)
   486	            self.blocked_until.pop(name, None)
   487	        return value
   488	
   489	    def peek(self, name: str) -> str:
   490	        """Cached value only. NEVER calls 1Password, so it cannot block a request.
   491	
   492	        The request path must not wait on a credential: on 2026-10-20 a span arriving
   493	        while the keys were cold held the HTTP handler for 90 seconds and the sender
   494	        timed out. A span that cannot be forwarded right now is counted and dropped,
   495	        which is visible in /stats, instead of stalling whoever sent it. The
   496	        background warmer is the only thing that calls out to 1Password.
   497	        """
   498	        with self.lock:
   499	            hit = self.cache.get(name)
   500	            if hit and self.clock() - hit[1] < self.ttl:
   501	                return hit[0]
   502	        raise Blocked(f'{name} key not cached yet')
   503	
   504	    def drop(self, name: str) -> None:
   505	        with self.lock:
   506	            self.cache.pop(name, None)
   507	
   508	
   509	def warm_loop(keys: KeyCache, names: list[str], stop, interval: float = KEY_REFRESH_INTERVAL) -> None:
   510	    """Keep every key fresh for the life of the process. Never raises, never exits
   511	    on a failed read: a failure waits KEY_BACKOFF_BASE (KeyCache's own backoff stops
   512	    the actual 1Password calls), a success waits `interval`. Uses stop.wait, so a
   513	    SIGTERM ends it promptly."""
   514	    while not stop.is_set():
   515	        failed = False
   516	        for name in names:
   517	            if stop.is_set():
   518	                return
   519	            try:
   520	                keys.get(name, force=True)
   521	                print(f'  {name} key read from 1Password (value not shown)')
   522	                sys.stdout.flush()
   523	            except Exception as err:  # a bad read must never end the warmer
   524	                failed = True
   525	                print(f'  {name} key still unavailable: {err if isinstance(err, Blocked) else type(err).__name__}',
   526	                      file=sys.stderr)
   527	                sys.stderr.flush()
   528	        if stop.wait(KEY_BACKOFF_BASE if failed else interval):
   529	            return
   530	
   531	
   532	def forward(name: str, body: bytes, keys: KeyCache) -> int:
   533	    url, header = UPSTREAMS[name]
   534	    from urllib.parse import urlsplit
   535	    if urlsplit(url).hostname not in ALLOWED_HOSTS:
   536	        raise Blocked('refused: upstream host is not in ALLOWED_HOSTS')
   537	    headers = {'Content-Type': 'application/x-protobuf', header: keys.peek(name)}
   538	    if name == 'langfuse':
   539	        headers['x-langfuse-ingestion-version'] = '4'
   540	    req = urllib.request.Request(url, data=body, headers=headers, method='POST')
   541	    try:
   542	        with urllib.request.urlopen(req, timeout=IO_TIMEOUT) as resp:
   543	            resp.read(64 * 1024)
   544	            return resp.status
   545	    except urllib.error.HTTPError as err:
   546	        err.read(4096)
   547	        if err.code in (401, 403):
   548	            keys.drop(name)  # a rotated key should not stay rejected until the TTL
   549	        return err.code
   550	    except urllib.error.URLError:
   551	        return 0  # network failure; never surface the reason, it can carry a URL with auth
   552	
