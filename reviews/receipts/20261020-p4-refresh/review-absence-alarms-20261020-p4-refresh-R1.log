   515	        failed = False
   516	        for name in names:
   517	            if stop.is_set():
   518	                return
   519	            try:
   520	                keys.get(name, force=True)
   521	                print(f'  {name} key read from 1Password (value not shown)')
   522	                sys.stdout.flush()
   523	            except Exception as err:  # a bad read must never end the warmer
   524	                failed = True
   525	                print(f'  {name} key still unavailable: {err if isinstance(err, Blocked) else type(err).__name__}',
   526	                      file=sys.stderr)
   527	                sys.stderr.flush()
   528	        if stop.wait(KEY_BACKOFF_BASE if failed else interval):
