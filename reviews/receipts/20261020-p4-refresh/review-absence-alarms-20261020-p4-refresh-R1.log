   809	
   810	        class FakeStop:
   811	            """Each wait() advances the clock by the requested time; ends after 6 waits."""
   812	            def __init__(self):
   813	                self.waits = []
   814	            def is_set(self):
   815	                return len(self.waits) >= 6
   816	            def wait(self, t):
