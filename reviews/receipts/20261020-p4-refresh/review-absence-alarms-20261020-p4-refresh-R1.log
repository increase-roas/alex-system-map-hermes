   426	
   427	def auth_for(name: str) -> str:
   428	    """Header VALUE for one upstream. Never print or log the return value."""
   429	    if name == 'signoz':
   430	        return signoz_headers()[SIGNOZ_HEADER]
   431	    if name == 'langfuse':
   432	        return langfuse_headers()['Authorization']
   433	    raise Blocked(f'no credential route for upstream {name}')
