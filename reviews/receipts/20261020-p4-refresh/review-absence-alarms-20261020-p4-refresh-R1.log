   293	# --------------------------------------------------------------------------- upstreams
   294	
   295	def _run(cmd: list[str], env: dict | None = None) -> str:
   296	    """Run a command, returning stdout. stderr is dropped: it could hold a key.
   297	
   298	    Every subprocess failure, a timeout included, becomes a Blocked carrying no
   299	    payload. Before this, a TimeoutExpired escaped as an unhandled traceback: it
   300	    killed the process and printed the command line into the job log, and KeepAlive
   301	    then relaunched it while still reporting "state = running".
   302	    """
   303	    try:
   304	        proc = subprocess.run(cmd, capture_output=True, text=True, env=env,
   305	                              timeout=HELPER_TIMEOUT)
   306	    except subprocess.TimeoutExpired:
   307	        raise Blocked(f'{Path(cmd[0]).name} did not answer within {HELPER_TIMEOUT}s') from None
   308	    except subprocess.SubprocessError:
   309	        raise Blocked(f'{Path(cmd[0]).name} could not be run') from None
   310	    if proc.returncode:
   311	        raise Blocked(f'{Path(cmd[0]).name} failed (exit {proc.returncode}); output withheld')
   312	    return proc.stdout.strip()
   313	
   314	
   315	# The proven credential path, reused rather than reimplemented.
   316	#
   317	# The hang I spent hours on is documented in op_items.robot_env: "Under the real HOME,
   318	# op 2.39.0 on Alex's MacBook stalls for minutes before any network step; with a private
   319	# HOME it answers in about a second". It also records that OP_BIOMETRIC_UNLOCK_ENABLED
   320	# and OP_CACHE alone do NOT stop it. I had set exactly those two and passed the real
   321	# HOME, which is why every launchd read timed out and why macOS kept asking Alex to let
   322	# "op" reach other apps: with the real HOME, op goes near the 1Password app's data.
   323	#
   324	# robot_env gives op a private HOME, OP_CONFIG_DIR and TMPDIR under
   325	# ~/.agents/runtime/op-robot, drops XDG_RUNTIME_DIR, and lets one `op daemon` serve every
   326	# robot call. Nothing here is hand-rolled any more.
   327	#
   328	# On top of that, finished headers are cached in the login Keychain, the same pattern
   329	# langfuse_otel_headers.py added on 2026-10-15 after 7,200 op calls a day starved every
   330	# other op tool. `security` works fine under launchd and never prompts, so the common
   331	# path touches 1Password not at all.
   332	CONNECTORS = Path.home() / '.agents/tools/connectors'
   333	LANGFUSE_HELPER = CONNECTORS / 'langfuse_otel_headers.py'
   334	SECURITY = '/usr/bin/security'
   335	CACHE_ACCOUNT = 'connectors-sync'
   336	CACHE_TTL_SECONDS = 12 * 3600
   337	SIGNOZ_CACHE_SERVICE = 'signoz-ingestion-header-cache'
   338	ROBOT_TOKEN_SERVICE = 'op-service-account-connectors-sync'
   339	# A single read gets a SHORT ceiling on purpose. A long one is worse than useless when
   340	# the failure mode is a modal dialog waiting on a human: it holds the prompt on screen.
   341	# A healthy robot call answers in about a second.
   342	OP_READ_TIMEOUT = 10
   343	
   344	
   345	def _load_op_items():
   346	    """Import the shared op_items module from ~/.agents. Read-only use of their code."""
   347	    import importlib.util
   348	    spec = importlib.util.spec_from_file_location('op_items', CONNECTORS / 'op_items.py')
   349	    if spec is None or spec.loader is None:
   350	        raise Blocked('op_items.py not found; cannot read credentials the proven way')
   351	    module = importlib.util.module_from_spec(spec)
   352	    spec.loader.exec_module(module)
   353	    return module
   354	
   355	
   356	def _keychain_get(service: str) -> dict | None:
   357	    proc = subprocess.run([SECURITY, 'find-generic-password', '-a', CACHE_ACCOUNT,
   358	                           '-s', service, '-w'], capture_output=True, text=True,
   359	                          timeout=OP_READ_TIMEOUT)
   360	    if proc.returncode:
   361	        return None
   362	    try:
   363	        held = json.loads(proc.stdout.strip())
   364	    except ValueError:
   365	        return None
   366	    if not isinstance(held, dict) or time.time() - float(held.get('ts', 0)) >= CACHE_TTL_SECONDS:
   367	        return None
   368	    headers = held.get('headers')
   369	    return headers if isinstance(headers, dict) and headers else None
   370	
   371	
   372	def _keychain_put(service: str, headers: dict) -> None:
   373	    # security(1) -i reads its command from stdin, so no credential rides in argv.
   374	    import shlex
   375	    command = ['add-generic-password', '-U', '-a', CACHE_ACCOUNT, '-s', service, '-w',
   376	               json.dumps({'ts': time.time(), 'headers': headers})]
   377	    subprocess.run([SECURITY, '-i'], input=shlex.join(command) + '\n',
   378	                   capture_output=True, text=True, timeout=OP_READ_TIMEOUT)
   379	
   380	
   381	def _robot_token() -> str:
   382	    proc = subprocess.run([SECURITY, 'find-generic-password', '-a', CACHE_ACCOUNT,
   383	                           '-s', ROBOT_TOKEN_SERVICE, '-w'], capture_output=True, text=True,
   384	                          timeout=OP_READ_TIMEOUT)
   385	    if proc.returncode or not proc.stdout.strip():
   386	        raise Blocked('the robot service-account token is not readable')
   387	    return proc.stdout.strip()
   388	
   389	
   390	def signoz_headers() -> dict:
   391	    """SigNoz ingestion header, Keychain-cached, read through robot_env on a miss."""
   392	    cached = _keychain_get(SIGNOZ_CACHE_SERVICE)
   393	    if cached:
   394	        return cached
   395	    op_items = _load_op_items()
   396	    token = _robot_token()
   397	    with op_items.robot_env(token) as env:
   398	        proc = subprocess.run(['op', 'read', SIGNOZ_OP_REF], capture_output=True, text=True,
   399	                              env=env, stdin=subprocess.DEVNULL, timeout=OP_READ_TIMEOUT)
   400	    if proc.returncode or not proc.stdout.strip():
   401	        raise Blocked('the SigNoz key could not be read from 1Password')
   402	    key = proc.stdout.strip()
   403	    if '\n' in key or '\r' in key:
   404	        raise Blocked('the SigNoz key does not have the expected shape')
   405	    headers = {SIGNOZ_HEADER: key}
   406	    _keychain_put(SIGNOZ_CACHE_SERVICE, headers)
   407	    return headers
   408	
   409	
   410	def langfuse_headers() -> dict:
   411	    """Langfuse headers from the EXISTING helper, which already owns its own 12h cache."""
   412	    if not LANGFUSE_HELPER.exists():
   413	        raise Blocked('the Langfuse header helper is missing')
   414	    proc = subprocess.run([sys.executable, '-B', str(LANGFUSE_HELPER)], capture_output=True,
   415	                          text=True, stdin=subprocess.DEVNULL, timeout=OP_READ_TIMEOUT)
   416	    if proc.returncode:
   417	        raise Blocked('the Langfuse header helper would not answer')
   418	    try:
   419	        headers = json.loads(proc.stdout.strip())
   420	    except ValueError:
   421	        raise Blocked('the Langfuse header helper returned nothing usable') from None
   422	    if not isinstance(headers, dict) or 'Authorization' not in headers:
   423	        raise Blocked('the Langfuse header helper returned no Authorization')
   424	    return headers
