   861	def main(argv: list[str] | None = None) -> int:
   862	    parser = argparse.ArgumentParser(description=__doc__,
   863	                                     formatter_class=argparse.RawDescriptionHelpFormatter)
   864	    parser.add_argument('--port', type=int, default=4320)
   865	    parser.add_argument('--upstream', action='append', choices=sorted(UPSTREAMS),
   866	                        help='repeatable; omit with --dry-run to forward nowhere')
   867	    parser.add_argument('--dry-run', action='store_true',
   868	                        help='accept, filter and count, but forward nothing')
   869	    parser.add_argument('--rate-per-min', type=int, default=DEFAULT_RATE_PER_MIN)
   870	    parser.add_argument('--log', default=None, help='JSONL path for per-request counts')
   871	    parser.add_argument('--self-test', action='store_true')
   872	    args = parser.parse_args(argv)
   873	
   874	    if args.self_test:
   875	        return self_test()
   876	
   877	    upstreams = args.upstream or []
   878	    if not upstreams and not args.dry_run:
   879	        print('Refusing to start: pass --upstream, or --dry-run to forward nothing.',
   880	              file=sys.stderr)
   881	        return 2
   882	
   883	    guard = RateGuard(args.rate_per_min, RATE_OVERRIDES)
   884	    keys = KeyCache(upstreams)
   885	
   886	    # Under launchd a stop arrives as SIGTERM, not KeyboardInterrupt. shutdown() cannot
   887	    # be called from the serving thread, so the handler only sets this flag and the main
   888	    # thread closes the listener and lets in-flight requests finish. Declared here
   889	    # because the key-warming thread waits on it too.
   890	    stop = threading.Event()
   891	
   892	    server = Collector(('127.0.0.1', args.port), upstreams=upstreams, guard=guard, keys=keys,
   893	                       dry_run=args.dry_run, log_path=Path(args.log) if args.log else None)
   894	    print(f'  listening on 127.0.0.1:{server.server_address[1]}/v1/traces')
   895	    print(f'  upstreams: {", ".join(upstreams) or "(none, dry run)"}')
   896	    print(f'  rate guard: {args.rate_per_min} spans/min per service')
   897	    print(f'  blocked: {", ".join(BLOCKED_SERVICES)}')
   898	    print(f'  counts: GET http://127.0.0.1:{server.server_address[1]}/stats')
   899	    sys.stdout.flush()
   900	
   901	    # Keys are warmed in the BACKGROUND, after the listener is already bound. Reading
   902	    # them first was a design bug: on 2026-10-20 a slow `op read` under launchd held the
   903	    # startup path for minutes, so the port never opened and the service looked dead
   904	    # while the process was perfectly healthy. Binding first means /stats answers at
   905	    # once, a span that cannot be forwarded is counted rather than lost, and the thing
   906	    # is diagnosable from outside. KeyCache's backoff keeps the retries cheap.
   907	    if upstreams and not args.dry_run:
   908	        threading.Thread(target=warm_loop, args=(keys, upstreams, stop), daemon=True, name='warm-keys').start()
   909	
   910	    previous = {}
   911	    worker = threading.Thread(target=server.serve_forever, kwargs={'poll_interval': 0.5})
   912	    try:
   913	        for sig in (signal.SIGTERM, signal.SIGINT):
   914	            previous[sig] = signal.signal(sig, lambda *_: stop.set())
   915	        worker.start()
   916	        stop.wait()
   917	    finally:
   918	        if worker.is_alive():
   919	            server.shutdown()
   920	            worker.join(timeout=10)
   921	        server.server_close()
   922	        for sig, handler in previous.items():
   923	            signal.signal(sig, handler)
   924	    # The final counts go to stdout, which launchd captures in the job's log.
   925	    print(json.dumps(server.stats.snapshot(), indent=2))
   926	    sys.stdout.flush()
   927	    return 0
