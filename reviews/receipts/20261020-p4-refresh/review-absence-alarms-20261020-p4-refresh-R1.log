   554	# --------------------------------------------------------------------------- server
   555	
   556	class Stats:
   557	    def __init__(self):
   558	        self.lock = threading.Lock()
   559	        self.kept = collections.Counter()
   560	        self.dropped = collections.Counter()
   561	        self.upstream = collections.Counter()
   562	        self.started = time.time()
   563	
   564	    def add(self, decision: Decision, statuses: dict[str, int]):
   565	        with self.lock:
   566	            self.kept.update(decision.kept)
   567	            self.dropped.update(decision.dropped)
   568	            for name, status in statuses.items():
   569	                self.upstream[f'{name}:{status}'] += 1
   570	
   571	    def snapshot(self) -> dict:
   572	        with self.lock:
   573	            hours = max((time.time() - self.started) / 3600, 1 / 3600)
   574	            return {
   575	                'uptime_hours': round(hours, 3),
   576	                'kept_spans': dict(self.kept),
   577	                'kept_spans_per_hour': {k: round(v / hours) for k, v in self.kept.items()},
   578	                'dropped_spans': dict(self.dropped),
   579	                'upstream_responses': dict(self.upstream),
   580	            }
   581	
   582	
   583	def is_loopback(host: str) -> bool:
   584	    try:
   585	        return ipaddress.ip_address(host).is_loopback
   586	    except ValueError:
   587	        return False
   588	
   589	
   590	class Collector(ThreadingHTTPServer):
   591	    daemon_threads = True
   592	    allow_reuse_address = True
   593	
   594	    def __init__(self, address, *, upstreams: list[str], guard: RateGuard,
   595	                 keys: KeyCache, dry_run: bool, log_path: Path | None):
   596	        super().__init__(address, Handler)
   597	        self.upstreams = upstreams
   598	        self.guard = guard
   599	        self.keys = keys
   600	        self.dry_run = dry_run
   601	        self.log_path = log_path
   602	        self.stats = Stats()
   603	
   604	    def log_row(self, row: dict) -> None:
   605	        if not self.log_path:
   606	            return
   607	        try:
   608	            with open(self.log_path, 'a') as handle:
   609	                handle.write(json.dumps(row) + '\n')
   610	        except OSError:
   611	            pass  # best effort: never fail a request because the log is unwritable
   612	
   613	
   614	class Handler(BaseHTTPRequestHandler):
   615	    protocol_version = 'HTTP/1.1'
   616	
   617	    def log_message(self, *args):
   618	        pass  # the request line could carry a query string; never log it
   619	
   620	    def _reply(self, status: int, body: bytes = b'') -> None:
   621	        self.send_response(status)
   622	        self.send_header('Content-Length', str(len(body)))
   623	        self.end_headers()
   624	        if body:
   625	            self.wfile.write(body)
   626	
   627	    def do_GET(self):
   628	        if self.path == '/stats':
   629	            body = json.dumps(self.server.stats.snapshot(), indent=2).encode()
   630	            self.send_response(200)
   631	            self.send_header('Content-Type', 'application/json')
   632	            self.send_header('Content-Length', str(len(body)))
   633	            self.end_headers()
   634	            self.wfile.write(body)
   635	            return
   636	        self._reply(404)
   637	
   638	    def do_POST(self):
   639	        if not is_loopback(self.client_address[0]):
   640	            self._reply(403)
   641	            return
   642	        if self.path != '/v1/traces':
   643	            self._reply(404)
   644	            return
   645	        try:
   646	            length = int(self.headers.get('Content-Length') or 0)
   647	        except ValueError:
   648	            self._reply(400)
   649	            return
   650	        if length <= 0 or length > MAX_BODY:
   651	            self._reply(413 if length > MAX_BODY else 400)
   652	            return
   653	        body = self.rfile.read(length)
   654	        try:
   655	            decision = filter_payload(body, self.server.guard)
   656	        except ValueError:
   657	            self._reply(400)
   658	            return
   659	
   660	        statuses: dict[str, int] = {}
   661	        if decision.body and not self.server.dry_run:
   662	            for name in self.server.upstreams:
   663	                try:
   664	                    statuses[name] = forward(name, decision.body, self.server.keys)
   665	                except Blocked:
   666	                    statuses[name] = -1
   667	        self.server.stats.add(decision, statuses)
   668	        self.server.log_row({
   669	            'ts': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
   670	            'bytes_in': length, 'kept': decision.kept, 'dropped': decision.dropped,
   671	            'upstream': statuses, 'dry_run': self.server.dry_run,
   672	        })
   673	        self._reply(200 if (not statuses or any(s == 200 for s in statuses.values())) else 502)
   674	
