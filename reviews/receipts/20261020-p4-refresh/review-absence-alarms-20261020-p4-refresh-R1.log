   676	# --------------------------------------------------------------------------- self test
   677	
   678	def self_test() -> int:
   679	    """No network, no listener. Proves the filter does what the docstring claims."""
   680	    import struct
   681	
   682	    def kvbody(key: str, val: str) -> bytes:
   683	        return delimited(1, key.encode()) + delimited(2, delimited(1, val.encode()))
   684	
   685	    def span(name: str) -> bytes:
   686	        now = time.time_ns()
   687	        return b''.join([
   688	            delimited(1, b'\x11' * 16), delimited(2, b'\x22' * 8), delimited(5, name.encode()),
   689	            varint((6 << 3) | 0) + varint(1),
   690	            varint((7 << 3) | 1) + struct.pack('<Q', now),
   691	            varint((8 << 3) | 1) + struct.pack('<Q', now + 1000),
   692	        ])
   693	
   694	    def resource_spans(service: str | None, n: int) -> bytes:
   695	        resource = delimited(1, kvbody('service.name', service)) if service is not None else b''
   696	        scope = delimited(2, b''.join(delimited(2, span(f's{i}')) for i in range(n)))
   697	        return delimited(1, delimited(1, resource) + scope)
   698	
   699	    checks: list[tuple[str, bool, str]] = []
   700	
   701	    def check(name: str, ok: bool, detail: str = ''):
   702	        checks.append((name, bool(ok), detail))
   703	
   704	    guard = RateGuard(DEFAULT_RATE_PER_MIN, {})
   705	    d = filter_payload(resource_spans('claude-code', 3), guard)
   706	    check('named service kept', d.kept == {'claude-code': 3} and len(d.body) > 0)
   707	
   708	    d = filter_payload(resource_spans(None, 2), RateGuard(600, {}))
   709	    check('resource with no attributes dropped', d.dropped == {'(unnamed)': 2} and d.body == b'')
   710	
   711	    d = filter_payload(resource_spans('', 2), RateGuard(600, {}))
   712	    check('empty service.name dropped', d.dropped == {'(unnamed)': 2} and d.body == b'')
   713	
   714	    d = filter_payload(resource_spans('codex-worker', 5), RateGuard(600, {}))
   715	    check('blocked service refused', d.dropped == {'blocked:codex-worker': 5} and d.body == b'')
   716	
   717	    d = filter_payload(resource_spans('typo-agent', 1), RateGuard(600, {}))
   718	    check('unknown name counted, not silently kept', d.dropped == {'unknown:typo-agent': 1})
   719	
   720	    # The flood case: labelled, known, but far over budget.
   721	    tiny = RateGuard(10, {})
   722	    first = filter_payload(resource_spans('claude-code', 10), tiny)
   723	    second = filter_payload(resource_spans('claude-code', 10), tiny)
   724	    check('rate guard passes the first burst', first.kept == {'claude-code': 10})
   725	    check('rate guard throttles the flood', second.dropped == {'throttled:claude-code': 10})
   726	
   727	    # One over-budget service must not starve another.
   728	    shared = RateGuard(10, {})
   729	    filter_payload(resource_spans('claude-code', 10), shared)
   730	    other = filter_payload(resource_spans('codex', 5), shared)
   731	    check('one sender cannot starve another', other.kept == {'codex': 5})
   732	
   733	    mixed = filter_payload(
   734	        resource_spans('claude-code', 1) + resource_spans(None, 4) + resource_spans('codex', 2),
   735	        RateGuard(600, {}))
   736	    check('mixed batch keeps the named and drops the rest',
   737	          mixed.kept == {'claude-code': 1, 'codex': 2} and mixed.dropped == {'(unnamed)': 4})
   738	    check('re-emitted body is parseable OTLP',
   739	          filter_payload(mixed.body, RateGuard(600, {})).kept == {'claude-code': 1, 'codex': 2})
   740	
   741	    check('loopback check rejects a public address', not is_loopback('8.8.8.8'))
   742	    check('loopback check accepts 127.0.0.1', is_loopback('127.0.0.1'))
   743	
   744	    # The amplifier fix. These exist because on 2026-10-20 this collector exhausted the
   745	    # shared 1Password service account by reading keys inside a KeepAlive restart loop.
   746	    calls = {'n': 0}
   747	    real_auth = globals()['auth_for']
   748	
   749	    def counting_auth(name):
   750	        calls['n'] += 1
   751	        raise Blocked('simulated 1Password failure')
   752	
   753	    globals()['auth_for'] = counting_auth
   754	    try:
   755	        cache = KeyCache(['signoz'])
   756	        refusals = []
   757	        for _ in range(5):
   758	            try:
   759	                cache.get('signoz')
   760	            except Blocked as err:
   761	                refusals.append(str(err))
