   275	        spans = count_spans(payload)
   276	        if not service:
   277	            dropped['(unnamed)'] += spans
   278	            continue
   279	        if service in blocked:
   280	            dropped[f'blocked:{service}'] += spans
   281	            continue
   282	        if known and service not in known:
   283	            dropped[f'unknown:{service}'] += spans
   284	            continue
   285	        if not guard.allow(service, spans):
   286	            dropped[f'throttled:{service}'] += spans
   287	            continue
   288	        kept_counts[service] += spans
   289	        out += delimited(1, payload)
   290	    return Decision(bytes(out), dict(kept_counts), dict(dropped))
   291	
