   992	def main(argv: list[str] | None = None) -> int:
   993	    parser = argparse.ArgumentParser(description=__doc__,
   994	                                     formatter_class=argparse.RawDescriptionHelpFormatter)
   995	    parser.add_argument('--port', type=int, default=4320)
   996	    parser.add_argument('--upstream', action='append', choices=sorted(UPSTREAMS),
   997	                        help='repeatable; omit with --dry-run to forward nowhere')
