   295	def _run(cmd: list[str], env: dict | None = None) -> str:
   296	    """Run a command, returning stdout. stderr is dropped: it could hold a key.
   297	
   298	    Every subprocess failure, a timeout included, becomes a Blocked carrying no
   299	    payload. Before this, a TimeoutExpired escaped as an unhandled traceback: it
   300	    killed the process and printed the command line into the job log, and KeepAlive
   301	    then relaunched it while still reporting "state = running".
   302	    """
   303	    try:
   304	        proc = subprocess.run(cmd, capture_output=True, text=True, env=env,
   305	                              timeout=HELPER_TIMEOUT)
   306	    except subprocess.TimeoutExpired:
   307	        raise Blocked(f'{Path(cmd[0]).name} did not answer within {HELPER_TIMEOUT}s') from None
   308	    except subprocess.SubprocessError:
   309	        raise Blocked(f'{Path(cmd[0]).name} could not be run') from None
   310	    if proc.returncode:
   311	        raise Blocked(f'{Path(cmd[0]).name} failed (exit {proc.returncode}); output withheld')
   312	    return proc.stdout.strip()
