   579	class Stats:
   580	    def __init__(self):
   581	        self.lock = threading.Lock()
   582	        self.kept = collections.Counter()
   583	        self.dropped = collections.Counter()
   584	        self.upstream = collections.Counter()
   585	        self.started = time.time()
   586	
   587	    def add(self, decision: Decision, statuses: dict[str, int]):
   588	        with self.lock:
   589	            self.kept.update(decision.kept)
   590	            self.dropped.update(decision.dropped)
   591	            for name, status in statuses.items():
   592	                self.upstream[f'{name}:{status}'] += 1
   593	
   594	    def snapshot(self) -> dict:
   595	        with self.lock:
   596	            hours = max((time.time() - self.started) / 3600, 1 / 3600)
   597	            return {
   598	                'uptime_hours': round(hours, 3),
   599	                'kept_spans': dict(self.kept),
   600	                'kept_spans_per_hour': {k: round(v / hours) for k, v in self.kept.items()},
   601	                'dropped_spans': dict(self.dropped),
   602	                'upstream_responses': dict(self.upstream),
   603	            }
   604	
   605	
   606	def is_loopback(host: str) -> bool:
   607	    try:
   608	        return ipaddress.ip_address(host).is_loopback
   609	    except ValueError:
   610	        return False
