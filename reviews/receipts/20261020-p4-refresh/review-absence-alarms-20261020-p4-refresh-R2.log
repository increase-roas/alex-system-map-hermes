   458	    relaunched it: the loop exhausted the account's authenticated path for everyone
   459	    until the reads stopped. So a failed read now blocks further attempts for an
   460	    exponentially growing interval, and a caller gets an immediate refusal instead
   461	    of a new subprocess.
   462	    """
   463	
   464	    def __init__(self, names: list[str], ttl: int = KEY_TTL, clock=time.monotonic):
   465	        self.names = names
   466	        self.ttl = ttl
   467	        self.clock = clock
   468	        self.lock = threading.Lock()
   469	        self.cache: dict[str, tuple[str, float]] = {}
   470	        self.failures: dict[str, int] = {}
   471	        self.blocked_until: dict[str, float] = {}
   472	
   473	    def backoff_for(self, failures: int) -> float:
   474	        return min(KEY_BACKOFF_BASE * (2 ** max(failures - 1, 0)), KEY_BACKOFF_MAX)
   475	
   476	    def get(self, name: str, force: bool = False) -> str:
   477	        """Cached value, or a read. force=True skips the cache hit (the refresh path)
   478	        but still honours the failure backoff."""
   479	        now = self.clock()
   480	        with self.lock:
   481	            hit = self.cache.get(name)
   482	            if hit and not force and now - hit[1] < self.ttl:
   483	                return hit[0]
   484	            wait = self.blocked_until.get(name, 0.0) - now
   485	            if wait > 0:
   486	                raise Blocked(f'{name} key unavailable; not retrying for {wait:.0f}s')
   487	        try:
   488	            value = auth_for(name)
   489	        except Exception as err:
   490	            # Any failure counts, not just Blocked: a raw TimeoutExpired once skipped
   491	            # this bookkeeping and the warmer retried at a fixed interval forever.
   492	            with self.lock:
   493	                self.failures[name] = self.failures.get(name, 0) + 1
   494	                delay = self.backoff_for(self.failures[name])
   495	                self.blocked_until[name] = self.clock() + delay
   496	                count = self.failures[name]
   497	            print(f'  {name} key read failed ({count} in a row); holding off {delay:.0f}s '
   498	                  f'so 1Password is not hammered', file=sys.stderr)
   499	            sys.stderr.flush()
   500	            if isinstance(err, Blocked):
   501	                raise
   502	            raise Blocked(f'{name} key read failed ({type(err).__name__})') from None
   503	        with self.lock:
   504	            self.cache[name] = (value, self.clock())
   505	            self.failures.pop(name, None)
   506	            self.blocked_until.pop(name, None)
   507	        return value
   508	
   509	    def peek(self, name: str) -> str:
   510	        """Cached value only. NEVER calls 1Password, so it cannot block a request.
   511	
   512	        The request path must not wait on a credential: on 2026-10-20 a span arriving
   513	        while the keys were cold held the HTTP handler for 90 seconds and the sender
   514	        timed out. A span that cannot be forwarded right now is counted and dropped,
   515	        which is visible in /stats, instead of stalling whoever sent it. The
   516	        background warmer is the only thing that calls out to 1Password.
   517	        """
   518	        with self.lock:
   519	            hit = self.cache.get(name)
   520	            if hit and self.clock() - hit[1] < self.ttl:
   521	                return hit[0]
   522	        raise Blocked(f'{name} key not cached yet')
   523	
   524	    def drop(self, name: str) -> None:
   525	        with self.lock:
   526	            self.cache.pop(name, None)
   527	
   528	
   529	def warm_loop(keys: KeyCache, names: list[str], stop, interval: float = KEY_REFRESH_INTERVAL) -> None:
   530	    """Keep every key fresh for the life of the process. Never raises, never exits
   531	    on a failed read: a failure waits KEY_BACKOFF_BASE (KeyCache's own backoff stops
   532	    the actual 1Password calls), a success waits `interval`. Uses stop.wait, so a
   533	    SIGTERM ends it promptly."""
   534	    # Reported once so the thread can be identified from outside, in the job log.
   535	    print(f'  key warmer started: thread={threading.current_thread().name}')
   536	    sys.stdout.flush()
   537	    while not stop.is_set():
   538	        failed = False
   539	        for name in names:
   540	            if stop.is_set():
   541	                return
   542	            try:
   543	                keys.get(name, force=True)
   544	                print(f'  {name} key read from 1Password (value not shown)')
   545	                sys.stdout.flush()
   546	            except Exception as err:  # a bad read must never end the warmer
   547	                failed = True
   548	                print(f'  {name} key still unavailable: {err if isinstance(err, Blocked) else type(err).__name__}',
   549	                      file=sys.stderr)
   550	                sys.stderr.flush()
   551	        if stop.wait(KEY_BACKOFF_BASE if failed else interval):
   552	            return
   553	
   554	
   555	def forward(name: str, body: bytes, keys: KeyCache) -> int:
   556	    url, header = UPSTREAMS[name]
   557	    from urllib.parse import urlsplit
   558	    if urlsplit(url).hostname not in ALLOWED_HOSTS:
   559	        raise Blocked('refused: upstream host is not in ALLOWED_HOSTS')
   560	    headers = {'Content-Type': 'application/x-protobuf', header: keys.peek(name)}
   561	    if name == 'langfuse':
   562	        headers['x-langfuse-ingestion-version'] = '4'
   563	    req = urllib.request.Request(url, data=body, headers=headers, method='POST')
   564	    try:
   565	        with urllib.request.urlopen(req, timeout=IO_TIMEOUT) as resp:
   566	            resp.read(64 * 1024)
   567	            return resp.status
   568	    except urllib.error.HTTPError as err:
   569	        err.read(4096)
   570	        if err.code in (401, 403):
   571	            keys.drop(name)  # a rotated key should not stay rejected until the TTL
   572	        return err.code
   573	    except urllib.error.URLError:
   574	        return 0  # network failure; never surface the reason, it can carry a URL with auth
   575	
   576	
   577	# --------------------------------------------------------------------------- server
   578	
   579	class Stats:
   580	    def __init__(self):
   581	        self.lock = threading.Lock()
   582	        self.kept = collections.Counter()
   583	        self.dropped = collections.Counter()
   584	        self.upstream = collections.Counter()
   585	        self.started = time.time()
   586	
   587	    def add(self, decision: Decision, statuses: dict[str, int]):
   588	        with self.lock:
   589	            self.kept.update(decision.kept)
   590	            self.dropped.update(decision.dropped)
   591	            for name, status in statuses.items():
   592	                self.upstream[f'{name}:{status}'] += 1
   593	
   594	    def snapshot(self) -> dict:
   595	        with self.lock:
   596	            hours = max((time.time() - self.started) / 3600, 1 / 3600)
   597	            return {
   598	                'uptime_hours': round(hours, 3),
   599	                'kept_spans': dict(self.kept),
   600	                'kept_spans_per_hour': {k: round(v / hours) for k, v in self.kept.items()},
   601	                'dropped_spans': dict(self.dropped),
   602	                'upstream_responses': dict(self.upstream),
   603	            }
