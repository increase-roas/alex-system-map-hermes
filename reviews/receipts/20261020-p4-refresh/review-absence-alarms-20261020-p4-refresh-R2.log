   231	    def limit_for(self, service: str) -> int:
   232	        return self.overrides.get(service, self.per_min)
   233	
   234	    def allow(self, service: str, spans: int) -> bool:
   235	        limit = self.limit_for(service)
   236	        if limit <= 0:
   237	            return False
   238	        now = self.clock()
   239	        with self.lock:
   240	            tokens, last = self.state.get(service, (float(limit), now))
   241	            tokens = min(float(limit), tokens + (now - last) * (limit / 60.0))
   242	            if tokens >= spans:
   243	                self.state[service] = (tokens - spans, now)
   244	                return True
   245	            self.state[service] = (tokens, now)
   246	            return False
