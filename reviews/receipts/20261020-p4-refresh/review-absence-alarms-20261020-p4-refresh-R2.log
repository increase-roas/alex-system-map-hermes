   452	class KeyCache:
   453	    """Holds each upstream's auth header, and refuses to hammer 1Password for it.
   454	
   455	    The backoff is the important part. The 1Password service account is shared by
   456	    every agent on this Mac and has a daily read cap. On 2026-10-20 this collector
   457	    read three secrets per launch, crashed on a slow read, and launchd's KeepAlive
   458	    relaunched it: the loop exhausted the account's authenticated path for everyone
   459	    until the reads stopped. So a failed read now blocks further attempts for an
   460	    exponentially growing interval, and a caller gets an immediate refusal instead
   461	    of a new subprocess.
   462	    """
   463	
   464	    def __init__(self, names: list[str], ttl: int = KEY_TTL, clock=time.monotonic):
   465	        self.names = names
   466	        self.ttl = ttl
   467	        self.clock = clock
   468	        self.lock = threading.Lock()
   469	        self.cache: dict[str, tuple[str, float]] = {}
   470	        self.failures: dict[str, int] = {}
   471	        self.blocked_until: dict[str, float] = {}
   472	
   473	    def backoff_for(self, failures: int) -> float:
   474	        return min(KEY_BACKOFF_BASE * (2 ** max(failures - 1, 0)), KEY_BACKOFF_MAX)
   475	
   476	    def get(self, name: str, force: bool = False) -> str:
   477	        """Cached value, or a read. force=True skips the cache hit (the refresh path)
   478	        but still honours the failure backoff."""
   479	        now = self.clock()
   480	        with self.lock:
   481	            hit = self.cache.get(name)
   482	            if hit and not force and now - hit[1] < self.ttl:
   483	                return hit[0]
   484	            wait = self.blocked_until.get(name, 0.0) - now
   485	            if wait > 0:
   486	                raise Blocked(f'{name} key unavailable; not retrying for {wait:.0f}s')
   487	        try:
   488	            value = auth_for(name)
   489	        except Exception as err:
   490	            # Any failure counts, not just Blocked: a raw TimeoutExpired once skipped
   491	            # this bookkeeping and the warmer retried at a fixed interval forever.
   492	            with self.lock:
   493	                self.failures[name] = self.failures.get(name, 0) + 1
   494	                delay = self.backoff_for(self.failures[name])
   495	                self.blocked_until[name] = self.clock() + delay
   496	                count = self.failures[name]
   497	            print(f'  {name} key read failed ({count} in a row); holding off {delay:.0f}s '
   498	                  f'so 1Password is not hammered', file=sys.stderr)
   499	            sys.stderr.flush()
   500	            if isinstance(err, Blocked):
   501	                raise
   502	            raise Blocked(f'{name} key read failed ({type(err).__name__})') from None
   503	        with self.lock:
   504	            self.cache[name] = (value, self.clock())
   505	            self.failures.pop(name, None)
   506	            self.blocked_until.pop(name, None)
   507	        return value
   508	
   509	    def peek(self, name: str) -> str:
   510	        """Cached value only. NEVER calls 1Password, so it cannot block a request.
   511	
   512	        The request path must not wait on a credential: on 2026-10-20 a span arriving
   513	        while the keys were cold held the HTTP handler for 90 seconds and the sender
   514	        timed out. A span that cannot be forwarded right now is counted and dropped,
   515	        which is visible in /stats, instead of stalling whoever sent it. The
   516	        background warmer is the only thing that calls out to 1Password.
   517	        """
   518	        with self.lock:
   519	            hit = self.cache.get(name)
   520	            if hit and self.clock() - hit[1] < self.ttl:
   521	                return hit[0]
   522	        raise Blocked(f'{name} key not cached yet')
   523	
   524	    def drop(self, name: str) -> None:
   525	        with self.lock:
   526	            self.cache.pop(name, None)
   527	
