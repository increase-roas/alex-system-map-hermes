   529	def warm_loop(keys: KeyCache, names: list[str], stop, interval: float = KEY_REFRESH_INTERVAL) -> None:
   530	    """Keep every key fresh for the life of the process. Never raises, never exits
   531	    on a failed read: a failure waits KEY_BACKOFF_BASE (KeyCache's own backoff stops
   532	    the actual 1Password calls), a success waits `interval`. Uses stop.wait, so a
   533	    SIGTERM ends it promptly."""
   534	    # Reported once so the thread can be identified from outside, in the job log.
   535	    print(f'  key warmer started: thread={threading.current_thread().name}')
   536	    sys.stdout.flush()
   537	    while not stop.is_set():
   538	        failed = False
   539	        for name in names:
   540	            if stop.is_set():
   541	                return
   542	            try:
   543	                keys.get(name, force=True)
   544	                print(f'  {name} key read from 1Password (value not shown)')
   545	                sys.stdout.flush()
   546	            except Exception as err:  # a bad read must never end the warmer
   547	                failed = True
   548	                print(f'  {name} key still unavailable: {err if isinstance(err, Blocked) else type(err).__name__}',
   549	                      file=sys.stderr)
   550	                sys.stderr.flush()
   551	        if stop.wait(KEY_BACKOFF_BASE if failed else interval):
   552	            return
   553	
   554	
   555	def forward(name: str, body: bytes, keys: KeyCache) -> int:
   556	    url, header = UPSTREAMS[name]
   557	    from urllib.parse import urlsplit
   558	    if urlsplit(url).hostname not in ALLOWED_HOSTS:
   559	        raise Blocked('refused: upstream host is not in ALLOWED_HOSTS')
   560	    headers = {'Content-Type': 'application/x-protobuf', header: keys.peek(name)}
   561	    if name == 'langfuse':
   562	        headers['x-langfuse-ingestion-version'] = '4'
   563	    req = urllib.request.Request(url, data=body, headers=headers, method='POST')
   564	    try:
   565	        with urllib.request.urlopen(req, timeout=IO_TIMEOUT) as resp:
   566	            resp.read(64 * 1024)
   567	            return resp.status
   568	    except urllib.error.HTTPError as err:
   569	        err.read(4096)
   570	        if err.code in (401, 403):
   571	            keys.drop(name)  # a rotated key should not stay rejected until the TTL
   572	        return err.code
   573	    except urllib.error.URLError:
   574	        return 0  # network failure; never surface the reason, it can carry a URL with auth
   575	
