   999	                        help='accept, filter and count, but forward nothing')
  1000	    parser.add_argument('--rate-per-min', type=int, default=DEFAULT_RATE_PER_MIN)
  1001	    parser.add_argument('--log', default=None, help='JSONL path for per-request counts')
  1002	    parser.add_argument('--self-test', action='store_true')
  1003	    args = parser.parse_args(argv)
  1004	
  1005	    if args.self_test:
  1006	        return self_test()
  1007	
  1008	    upstreams = args.upstream or []
  1009	    if not upstreams and not args.dry_run:
  1010	        print('Refusing to start: pass --upstream, or --dry-run to forward nothing.',
  1011	              file=sys.stderr)
