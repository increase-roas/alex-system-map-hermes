  1023	    server = Collector(('127.0.0.1', args.port), upstreams=upstreams, guard=guard, keys=keys,
  1024	                       dry_run=args.dry_run, log_path=Path(args.log) if args.log else None)
  1025	    print(f'  listening on 127.0.0.1:{server.server_address[1]}/v1/traces')
  1026	    print(f'  upstreams: {", ".join(upstreams) or "(none, dry run)"}')
  1027	    print(f'  rate guard: {args.rate_per_min} spans/min per service')
  1028	    print(f'  blocked: {", ".join(BLOCKED_SERVICES)}')
  1029	    print(f'  counts: GET http://127.0.0.1:{server.server_address[1]}/stats')
