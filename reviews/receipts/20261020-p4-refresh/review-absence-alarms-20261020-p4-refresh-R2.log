   699	# --------------------------------------------------------------------------- self test
   700	
   701	def self_test() -> int:
   702	    """No network, no listener. Proves the filter does what the docstring claims."""
   703	    import struct
   704	
   705	    def kvbody(key: str, val: str) -> bytes:
   706	        return delimited(1, key.encode()) + delimited(2, delimited(1, val.encode()))
   707	
   708	    def span(name: str) -> bytes:
   709	        now = time.time_ns()
   710	        return b''.join([
   711	            delimited(1, b'\x11' * 16), delimited(2, b'\x22' * 8), delimited(5, name.encode()),
   712	            varint((6 << 3) | 0) + varint(1),
   713	            varint((7 << 3) | 1) + struct.pack('<Q', now),
   714	            varint((8 << 3) | 1) + struct.pack('<Q', now + 1000),
   715	        ])
   716	
   717	    def resource_spans(service: str | None, n: int) -> bytes:
   718	        resource = delimited(1, kvbody('service.name', service)) if service is not None else b''
   719	        scope = delimited(2, b''.join(delimited(2, span(f's{i}')) for i in range(n)))
   720	        return delimited(1, delimited(1, resource) + scope)
   721	
   722	    checks: list[tuple[str, bool, str]] = []
   723	
   724	    def check(name: str, ok: bool, detail: str = ''):
   725	        checks.append((name, bool(ok), detail))
   726	
   727	    guard = RateGuard(DEFAULT_RATE_PER_MIN, {})
   728	    d = filter_payload(resource_spans('claude-code', 3), guard)
   729	    check('named service kept', d.kept == {'claude-code': 3} and len(d.body) > 0)
   730	
   731	    d = filter_payload(resource_spans(None, 2), RateGuard(600, {}))
   732	    check('resource with no attributes dropped', d.dropped == {'(unnamed)': 2} and d.body == b'')
   733	
   734	    d = filter_payload(resource_spans('', 2), RateGuard(600, {}))
   735	    check('empty service.name dropped', d.dropped == {'(unnamed)': 2} and d.body == b'')
   736	
   737	    d = filter_payload(resource_spans('codex-worker', 5), RateGuard(600, {}))
   738	    check('blocked service refused', d.dropped == {'blocked:codex-worker': 5} and d.body == b'')
   739	
   740	    d = filter_payload(resource_spans('typo-agent', 1), RateGuard(600, {}))
   741	    check('unknown name counted, not silently kept', d.dropped == {'unknown:typo-agent': 1})
   742	
   743	    # The flood case: labelled, known, but far over budget.
   744	    tiny = RateGuard(10, {})
   745	    first = filter_payload(resource_spans('claude-code', 10), tiny)
   746	    second = filter_payload(resource_spans('claude-code', 10), tiny)
   747	    check('rate guard passes the first burst', first.kept == {'claude-code': 10})
   748	    check('rate guard throttles the flood', second.dropped == {'throttled:claude-code': 10})
   749	
   750	    # One over-budget service must not starve another.
   751	    shared = RateGuard(10, {})
   752	    filter_payload(resource_spans('claude-code', 10), shared)
   753	    other = filter_payload(resource_spans('codex', 5), shared)
   754	    check('one sender cannot starve another', other.kept == {'codex': 5})
   755	
   756	    mixed = filter_payload(
   757	        resource_spans('claude-code', 1) + resource_spans(None, 4) + resource_spans('codex', 2),
   758	        RateGuard(600, {}))
   759	    check('mixed batch keeps the named and drops the rest',
   760	          mixed.kept == {'claude-code': 1, 'codex': 2} and mixed.dropped == {'(unnamed)': 4})

