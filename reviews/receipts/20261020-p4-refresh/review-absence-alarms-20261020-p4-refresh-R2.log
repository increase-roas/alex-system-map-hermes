   613	class Collector(ThreadingHTTPServer):
   614	    daemon_threads = True
   615	    allow_reuse_address = True
   616	
   617	    def __init__(self, address, *, upstreams: list[str], guard: RateGuard,
   618	                 keys: KeyCache, dry_run: bool, log_path: Path | None):
   619	        super().__init__(address, Handler)
   620	        self.upstreams = upstreams
   621	        self.guard = guard
   622	        self.keys = keys
   623	        self.dry_run = dry_run
   624	        self.log_path = log_path
   625	        self.stats = Stats()
   626	
   627	    def log_row(self, row: dict) -> None:
   628	        if not self.log_path:
   629	            return
   630	        try:
   631	            with open(self.log_path, 'a') as handle:
   632	                handle.write(json.dumps(row) + '\n')
   633	        except OSError:
   634	            pass  # best effort: never fail a request because the log is unwritable
   635	
   636	
   637	class Handler(BaseHTTPRequestHandler):
   638	    protocol_version = 'HTTP/1.1'
   639	
   640	    def log_message(self, *args):
   641	        pass  # the request line could carry a query string; never log it
   642	
   643	    def _reply(self, status: int, body: bytes = b'') -> None:
   644	        self.send_response(status)
   645	        self.send_header('Content-Length', str(len(body)))
   646	        self.end_headers()
   647	        if body:
   648	            self.wfile.write(body)
   649	
   650	    def do_GET(self):
   651	        if self.path == '/stats':
   652	            body = json.dumps(self.server.stats.snapshot(), indent=2).encode()
   653	            self.send_response(200)
   654	            self.send_header('Content-Type', 'application/json')
   655	            self.send_header('Content-Length', str(len(body)))
   656	            self.end_headers()
   657	            self.wfile.write(body)
   658	            return
   659	        self._reply(404)
   660	
   661	    def do_POST(self):
   662	        if not is_loopback(self.client_address[0]):
   663	            self._reply(403)
   664	            return
   665	        if self.path != '/v1/traces':
   666	            self._reply(404)
   667	            return
   668	        try:
   669	            length = int(self.headers.get('Content-Length') or 0)
   670	        except ValueError:
   671	            self._reply(400)
   672	            return
   673	        if length <= 0 or length > MAX_BODY:
   674	            self._reply(413 if length > MAX_BODY else 400)
   675	            return
   676	        body = self.rfile.read(length)
   677	        try:
   678	            decision = filter_payload(body, self.server.guard)
   679	        except ValueError:
   680	            self._reply(400)
   681	            return
