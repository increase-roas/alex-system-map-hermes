   259	
   260	def filter_payload(body: bytes, guard: RateGuard, known=KNOWN_SERVICES,
   261	                   blocked=BLOCKED_SERVICES) -> Decision:
   262	    """Keep only named, allowed, in-budget ResourceSpans. Re-emit valid OTLP."""
   263	    kept_counts: dict[str, int] = collections.Counter()
   264	    dropped: dict[str, int] = collections.Counter()
   265	    out = bytearray()
   266	    for field, wire, payload, _s, _e in iter_fields(body):
   267	        if field != 1 or wire != 2:
   268	            continue  # ExportTraceServiceRequest.resource_spans only
   269	        resource = b''
   270	        for rf, rw, rp, _rs, _re in iter_fields(payload):
   271	            if rf == 1 and rw == 2:
   272	                resource = rp
   273	                break
   274	        service = service_name_of(resource)
   275	        spans = count_spans(payload)
   276	        if not service:
   277	            dropped['(unnamed)'] += spans
   278	            continue
   279	        if service in blocked:
   280	            dropped[f'blocked:{service}'] += spans
   281	            continue
   282	        if known and service not in known:
   283	            dropped[f'unknown:{service}'] += spans
   284	            continue
   285	        if not guard.allow(service, spans):
   286	            dropped[f'throttled:{service}'] += spans
   287	            continue
   288	        kept_counts[service] += spans
   289	        out += delimited(1, payload)
   290	    return Decision(bytes(out), dict(kept_counts), dict(dropped))
